---
import { existsSync, readFileSync } from 'node:fs';
import copy from '../content/copy.json';

/**
 * Cena 2 — o burger explodido. A cena que vende o projeto.
 *
 * As camadas vem de public/layers/manifest.json, produzido por
 * produce-layers.mjs. O manifest so e escrito quando as sete camadas fecham na
 * mesma execucao — entao ou a cena tem o conjunto completo, ou cai no
 * placeholder. Nunca meio conjunto: meia composicao vira colagem, e colagem e
 * exatamente o defeito que mata esta cena.
 */

type Camada = {
  id: string;
  src?: string;
  order: number;
  explodeY: number;
  speed: number;
  mobile: boolean;
  largura?: number;
  altura?: number;
  /** Largura final relativa ao pao (1.0 = mesma largura). Ver produce-layers.mjs. */
  larguraRelativa?: number;
  /** Quanto da propria altura a camada acrescenta a pilha. */
  assentamento?: number;
};

const caminhoManifest = new URL('../../public/assets/layers/manifest.json', import.meta.url);

/** Contrato de fallback, identico ao do script. Vale enquanto nao ha imagem. */
const CAMADAS_PLACEHOLDER: Camada[] = [
  { id: 'pao-superior', order: 1, explodeY: -180, speed: 1.0, mobile: true },
  { id: 'alface', order: 2, explodeY: -120, speed: 0.85, mobile: false },
  { id: 'tomate-cebola', order: 3, explodeY: -70, speed: 0.7, mobile: false },
  { id: 'queijo', order: 4, explodeY: -30, speed: 0.55, mobile: true },
  { id: 'blend', order: 5, explodeY: 0, speed: 0.4, mobile: true },
  { id: 'bacon', order: 6, explodeY: 40, speed: 0.3, mobile: false },
  { id: 'pao-inferior', order: 7, explodeY: 90, speed: 0.2, mobile: true },
];

const temManifest = existsSync(caminhoManifest);
const camadas: Camada[] = temManifest
  ? JSON.parse(readFileSync(caminhoManifest, 'utf8')).camadas
  : CAMADAS_PLACEHOLDER;

const legendas = copy.explode.legendas as Record<string, string>;

/**
 * LAYOUT DA PILHA — spec CORRECAOBURGERSTACK, etapas 2 e 5.
 *
 * Antes daqui a pilha usava margem negativa com uma sobreposicao unica para
 * todas as camadas. Duas coisas quebravam:
 *
 * 1. Sobreposicao uniforme trata queijo derretido e pao como se afundassem
 *    igual. Nao afundam — e por isso o queijo "flutuava" e a cebola sumia
 *    dentro da alface.
 * 2. Todas as camadas na mesma largura. Numa vista de lado, a camada que esta
 *    ATRAS por z-index so aparece se transbordar lateralmente a que esta na
 *    frente. Com largura igual, o bacon ficava 100% coberto pelo blend.
 *
 * Agora cada camada carrega larguraRelativa e assentamento (vindos do manifest,
 * escritos por produce-layers.mjs) e a posicao de repouso e ACUMULADA de baixo
 * para cima usando a altura visual real de cada uma.
 *
 * Tudo e calculado em fracoes da largura base, nunca em px: assim a mesma conta
 * vale em 390px e em 1440px sem media query.
 */

/** Altura visual da camada, em fracoes da largura base da pilha. */
function alturaVisual(camada: Camada) {
  if (!camada.largura || !camada.altura) return 0;
  return (camada.larguraRelativa ?? 1) * (camada.altura / camada.largura);
}

/**
 * Posicao de repouso, acumulando de BAIXO para cima — a ordem em que um
 * hamburguer e montado de verdade.
 *
 * assentamento diz quanto da propria altura a camada acrescenta a pilha: 1.0
 * encosta sem afundar, 0 afunda por completo na de baixo.
 */
const deBaixoParaCima = [...camadas].sort((a, b) => b.order - a.order);
const repousoPorId = new Map<string, number>();
let pilha = 0;

for (const camada of deBaixoParaCima) {
  repousoPorId.set(camada.id, -pilha);
  pilha += alturaVisual(camada) * (camada.assentamento ?? 0.5);
}

/**
 * Normalizacao para o topo do container.
 *
 * O acumulo acima produz valores negativos subindo a partir do zero. Para virar
 * `top` de elemento absoluto, tudo desloca ate que a camada mais alta fique em
 * zero.
 */
const topos = camadas.map((c) => (repousoPorId.get(c.id) ?? 0) - alturaVisual(c) / 2);
const topoMaisAlto = Math.min(...topos);
const baseMaisBaixa = Math.max(
  ...camadas.map((c) => (repousoPorId.get(c.id) ?? 0) + alturaVisual(c) / 2)
);

/** Altura total da pilha, em fracoes da largura base. Vira aspect-ratio no CSS. */
const RAZAO_DA_PILHA = baseMaisBaixa - topoMaisAlto;

/**
 * A camada mais larga define o quanto a pilha transborda para os lados.
 *
 * Com larguraRelativa de ate 1.18, a alface mede 18% a mais que a largura base.
 * Se a base for 100% do espaco disponivel, esse excedente sai pela lateral da
 * tela — foi o que aconteceu na primeira medicao apos aplicar o spec. Dividir a
 * largura disponivel por este maximo faz a camada mais larga caber exatamente.
 */
const MAIOR_RAZAO_LATERAL = Math.max(...camadas.map((c) => c.larguraRelativa ?? 1));

function estiloDaCamada(camada: Camada) {
  const centro = repousoPorId.get(camada.id) ?? 0;
  const topo = centro - alturaVisual(camada) / 2 - topoMaisAlto;
  return [
    // Maior z-index quanto mais alto na pilha fisica — monotonico, sem excecao.
    `z-index: ${10 - camada.order}`,
    `--ratio: ${(camada.larguraRelativa ?? 1).toFixed(3)}`,
    `--topo: ${topo.toFixed(4)}`,
  ].join('; ');
}
---

<section class="explode textura-brasa" id="explode" aria-labelledby="explode-titulo">
  <!-- Texto de fundo: parallax mais lento que qualquer ingrediente -->
  <div class="explode__fundo" aria-hidden="true" data-parallax="0.15">
    {copy.explode.textoFundo}
  </div>

  <div class="explode__conteudo">
    <h2 id="explode-titulo" class="explode__titulo">{copy.explode.titulo}</h2>
    <p class="explode__texto">{copy.explode.texto}</p>
  </div>

  <ul
    class="explode__camadas"
    role="list"
    style={`--razao-pilha: ${(RAZAO_DA_PILHA || 1.2).toFixed(4)}; --transbordo: ${MAIOR_RAZAO_LATERAL.toFixed(3)}`}
  >
    {
      camadas.map((camada) => (
        <li
          class="explode__camada"
          data-layer={camada.id}
          data-explode-y={camada.explodeY}
          data-speed={camada.speed}
          data-mobile={camada.mobile}
          style={estiloDaCamada(camada)}
        >
          {
            camada.src ? (
              <img
                class="explode__img"
                src={camada.src}
                alt={legendas[camada.id]}
                width={camada.largura}
                height={camada.altura}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="explode__placeholder" role="img" aria-label={legendas[camada.id]}>
                <span>{legendas[camada.id]}</span>
              </div>
            )
          }
          {/* Sombra de contato: a camada precisa POUSAR sobre a de baixo, nao
              pairar sobre ela. Ver nota no CSS. */}
          <span class="explode__sombra" aria-hidden="true" />
        </li>
      ))
    }
  </ul>
</section>

<style>
  /**
   * Fluxo em coluna, nao place-items: center.
   *
   * Enquanto as camadas eram placeholders de 3rem, empilhar tudo no centro
   * funcionava. Com imagem real elas passaram de 30rem de altura e passaram por
   * baixo do texto — titulo e paragrafo ficaram ilegiveis sobre o pao. O texto
   * agora tem faixa propria acima da pilha.
   */
  .explode {
    position: relative;
    min-height: var(--cena-altura);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.5rem;
    padding: 6rem 1.5rem;
    background-color: var(--color-carvao);
    overflow: hidden;
  }

  .explode__fundo {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: var(--text-display);
    line-height: 0.85;
    text-align: center;
    color: var(--color-terracota);
    text-transform: uppercase;
    user-select: none;
    will-change: transform;
  }

  .explode__conteudo {
    position: relative;
    z-index: 20;
    max-width: 34rem;
    text-align: center;
    flex-shrink: 0;
  }

  .explode__titulo {
    font-family: var(--font-display);
    font-size: var(--text-titulo);
    color: var(--color-creme);
    text-transform: uppercase;
  }

  .explode__texto {
    margin-top: 1rem;
    color: var(--color-areia);
    line-height: 1.6;
  }

  .explode__camadas {
    position: relative;
    z-index: 15;
    list-style: none;
    padding: 0;
    margin: 0;
    /* A largura e limitada pela ALTURA disponivel, nao por um teto fixo.
       --razao-pilha vem do componente e diz quantas vezes a largura a pilha
       mede de altura (soma das proporcoes reais das camadas, ja descontada a
       sobreposicao). Dividir a altura util por ela devolve a maior largura que
       ainda deixa o hamburguer INTEIRO dentro da cena pinada.

       Antes havia so `min(100%, 24rem)`, e era por isso que o pao de baixo
       aparecia cortado: 24rem geravam uma pilha de 658px que, somada aos 313px
       ocupados pelo texto, passavam do viewport.

       --desconto-altura e a soma do que a pilha NAO pode ocupar: padding da
       secao (12rem), altura do texto e o gap entre os dois, mais folga. Ele
       muda por breakpoint porque o mobile usa padding menor e um texto que
       quebra em mais linhas — por isso e custom property e nao numero fixo. */
    --desconto-altura: 26.5rem;
    /* Dividido por --transbordo: a camada mais larga (alface, 1.18) precisa
       caber na tela, e nao so a largura base. Sem isso a alface e o bacon saem
       pela lateral do viewport. */
    --largura-base: min(
      calc(100% / var(--transbordo, 1.18)),
      24rem,
      calc((100svh - var(--desconto-altura)) / var(--razao-pilha, 1.2))
    );
    width: var(--largura-base);
    /* A pilha deixou de ser fluxo normal: as camadas sao absolutas e o container
       precisa reservar a altura por conta propria. */
    height: calc(var(--largura-base) * var(--razao-pilha, 1.2));
    margin-inline: auto;
    /* Contexto de empilhamento proprio: o z-index das camadas nao vaza para o
       resto da pagina nem disputa com o texto da cena. */
    isolation: isolate;
    /* NAO usar transform-style: preserve-3d aqui — o navegador passa a pintar
       por translateZ e ignora o z-index, e a ordem das camadas vira aleatoria. */
  }

  /**
   * Cada camada e posicionada pelo `top`, nunca por transform.
   *
   * Isso e deliberado e e o que mantem o fallback funcionando: o hamburguer ja
   * nasce MONTADO no HTML, sem depender de JS. O transform fica inteiramente
   * livre para o GSAP animar a dispersao, e sob prefers-reduced-motion, onde
   * nenhum transform e aplicado, o que sobra e exatamente a pilha montada.
   *
   * --topo e --ratio vem do componente, em fracoes da largura base.
   */
  .explode__camada {
    position: absolute;
    left: 50%;
    top: calc(var(--topo, 0) * var(--largura-base));
    width: calc(var(--ratio, 1) * var(--largura-base));
    /* Centraliza sem gastar o transform. */
    margin-left: calc(var(--ratio, 1) * var(--largura-base) / -2);
    will-change: transform;
  }

  /**
   * Sombra de CONTATO — o que faz a camada pousar em vez de pairar.
   *
   * O cliente relatou "o queijo esta levitando" e "o tomate parece dentro do
   * pao". Nao era z-index: z-index resolve ORDEM, nunca CONTATO. A literatura de
   * compositing e direta — objeto sem sombra de contato le como falso na hora, e
   * nenhuma calibragem de empilhamento substitui isso.
   *
   * A sombra e uma elipse achatada logo abaixo da camada, encolhida nas laterais
   * para nao virar barra reta. Nasce VISIVEL: o estado de repouso do HTML e o
   * hamburguer montado, entao ele ja vem com as sombras assentadas, e o GSAP
   * apenas as apaga no inicio do trilho, quando as pecas estao no ar.
   */
  .explode__sombra {
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: -2%;
    height: 7%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgb(0 0 0 / 0.7), transparent 70%);
    filter: blur(8px);
    pointer-events: none;
    /* Atras da propria camada: a sombra pertence ao que esta EMBAIXO dela. */
    z-index: -1;
  }

  .explode__img {
    display: block;
    width: 100%;
    height: auto;
    /* Sombra propria: as camadas foram geradas sem sombra de fundo, entao a
       profundidade entre elas vem daqui. Sem isso o empilhamento fica chapado. */
    filter: drop-shadow(0 12px 18px rgb(0 0 0 / 0.45));
  }

  /* Placeholder visivel enquanto os PNGs nao chegam — some sozinho quando
     a <img> real substituir este bloco. */
  .explode__placeholder {
    display: grid;
    place-items: center;
    /* A lista deixou de ser grid quando as imagens entraram; o placeholder
       precisa se centralizar sozinho. */
    margin-inline: auto;
    width: min(70vw, 22rem);
    height: 3.25rem;
    border: 1px dashed var(--color-brasa);
    border-radius: 999px;
    color: var(--color-brasa);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    opacity: 0.75;
  }

  @media (max-width: 767px) {
    /* A cena e pinada: ela precisa caber EXATAMENTE na tela, senao o pin
       reserva altura que nao existe e o fim do trilho cai fora do quadro.
       Medido em Pixel 5, a secao fechava 793px num viewport de 727 — o padrao
       de 6rem em cima e embaixo era o excedente. Aqui o respiro vertical cede
       para o hamburguer, que e o que a pessoa veio ver. */
    .explode {
      padding-block: 3rem;
      gap: 1.5rem;
    }

    /* Padding menor libera altura, entao o desconto cai junto e o hamburguer
       fica maior no celular — que e onde 90% das pessoas vao ver a cena. */
    .explode__camadas {
      --desconto-altura: 22rem;
    }

    /* O contrato do manifest ainda permite excluir camada do mobile, mas hoje
       o conjunto inteiro vem marcado mobile:true e nada e cortado. A regra fica
       porque o contrato existe — nao porque haja camada escondida. */
    .explode__camada[data-mobile='false'] {
      display: none;
    }
  }
</style>
