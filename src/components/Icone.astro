---
/**
 * Ícones de linha da marca.
 *
 * Substituem os emojis que estavam nos pilares. Emoji como ícone parece
 * atalho barato: renderiza diferente em cada sistema, muda de cor com a fonte
 * do aparelho e derruba a credibilidade de uma página que precisa parecer
 * profissional para o dono fechar negócio.
 *
 * Traço em vez de preenchimento porque o desenho fica com o mesmo peso visual
 * do texto ao lado. `currentColor` deixa a cor ser decidida pelo contexto.
 */
/**
 * `carne` e `pao` continuam aqui sem uso na página desde 31/08, quando os
 * pilares deixaram de repetir a vista explodida e passaram a falar de processo.
 * Não foram removidos porque o componente é renderizado no servidor: o galho
 * que não casa com `nome` não gera um byte de HTML, então manter a chave
 * completa custa zero no cliente e evita redesenhar o ícone no dia em que um
 * pilar de produto voltar.
 */
interface Props {
  nome: 'carne' | 'pao' | 'molho' | 'cerrado' | 'brasa' | 'hora';
  tamanho?: number;
}

const { nome, tamanho = 32 } = Astro.props;
---

<svg
  width={tamanho}
  height={tamanho}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    nome === 'carne' && (
      <>
        {/* Disco de carne visto de lado, com a marca da grelha */}
        <ellipse cx="16" cy="13" rx="11" ry="5" />
        <path d="M5 13v4c0 2.8 4.9 5 11 5s11-2.2 11-5v-4" />
        <path d="M10 12.4c1.6-.7 3.6-1.1 6-1.1s4.4.4 6 1.1" />
      </>
    )
  }

  {
    nome === 'pao' && (
      <>
        {/* Pão de hambúrguer: tampa abaulada e base */}
        <path d="M4 15c0-5.5 5.4-9 12-9s12 3.5 12 9" />
        <path d="M4 15h24" />
        <path d="M6 19h20c0 3.3-4.5 5-10 5s-10-1.7-10-5z" />
        <path d="M12 10.5h.01M17 9.5h.01M21 11h.01" />
      </>
    )
  }

  {
    nome === 'molho' && (
      <>
        {/* Gota escorrendo de um bico */}
        <path d="M11 4h10l-1.5 6h-7z" />
        <path d="M16 10v5" />
        <path d="M16 15c3.3 3.4 5 6.1 5 8.2A5 5 0 0 1 11 23.2c0-2.1 1.7-4.8 5-8.2z" />
      </>
    )
  }

  {
    nome === 'brasa' && (
      <>
        {/*
          Chama com língua interna sobre duas linhas de brasa.

          A língua interna e as linhas da base existem para separar este ícone
          do `molho`, que também é uma gota fechada e apontada — sem elas os
          dois viram a mesma silhueta a 32px. As linhas embaixo também dão ao
          fogo uma FONTE no quadro, que é a mesma regra que o LOOK.md cobra das
          imagens.
        */}
        <path d="M16 3.5c-4.2 4.6-6.3 8-6.3 10.4a6.3 6.3 0 0 0 12.6 0c0-2.4-2.1-5.8-6.3-10.4z" />
        <path d="M16 12.6c-1.6 1.9-2.4 3.3-2.4 4.3a2.4 2.4 0 0 0 4.8 0c0-1-.8-2.4-2.4-4.3z" />
        <path d="M7 24h18" />
        <path d="M10.5 27.5h11" />
      </>
    )
  }

  {
    nome === 'hora' && (
      <>
        {/* Cronômetro: o pedido é que dá a partida na montagem */}
        <circle cx="16" cy="17.5" r="9.5" />
        <path d="M16 12.5v5l3.5 2.5" />
        <path d="M12.5 4.5h7" />
        <path d="M16 4.5V8" />
      </>
    )
  }

  {
    nome === 'cerrado' && (
      <>
        {/* Duas palmeiras, o mesmo símbolo da logo da casa */}
        <path d="M11 27c0-6.5.7-11 2-13.5" />
        <path d="M13 13.5c-2.8-2.4-5.6-2.4-8 0 2.4-1.2 4.7-1.2 7 0" />
        <path d="M13 13.5c2.6-2.6 5.4-2.6 8 0-2.5-1.3-4.9-1.3-7 0" />
        <path d="M13 13.5c-.6-3.4.4-5.9 3-7.5-1.6 2.2-2.2 4.7-2 7.5" />
        <path d="M23 27c0-4.6.5-7.9 1.5-10" />
        <path d="M24.5 17c-1.8-1.6-3.6-1.6-5.2 0 1.6-.8 3.1-.8 4.6 0" />
        <path d="M24.5 17c1.7-1.7 3.4-1.7 5 0-1.6-.8-3.1-.8-4.4 0" />
      </>
    )
  }
</svg>
