---
/**
 * Fontes self-hosted via @fontsource, nao via Google Fonts.
 *
 * Os tokens ja pediam Anton e Inter desde o inicio, mas ninguem tinha
 * importado o arquivo — a pagina inteira caia no sans do sistema e perdia a
 * personalidade da marca. Aparece so quando se olha o render.
 *
 * Self-hosted em vez de CDN do Google: elimina DNS + TLS para outro dominio no
 * caminho critico da fonte, que e exatamente o custo que pesa no 4G do
 * interior. O Astro ainda faz hash e cache longo dos arquivos.
 */
import '@fontsource/anton/400.css';
import '@fontsource-variable/inter';

/**
 * Preload dos subsets latinos.
 *
 * A auditoria mediu CLS de 0.059, e o culpado não era imagem: o shift acontece
 * aos ~2s no bloco do hero, exatamente quando o Anton termina de baixar e o
 * texto reflui. É FOUT — o @fontsource usa font-display: swap, então a página
 * pinta com a fonte do sistema e reflui quando a real chega.
 *
 * Preload em vez de font-display: optional porque o H1 do hero é o elemento de
 * LCP e é justamente ele que carrega a personalidade da marca. Com `optional`,
 * quem estivesse em rede ruim veria a página inteira na fonte do sistema — que
 * foi o defeito que os prints pegaram lá atrás.
 *
 * Só os subsets latinos: os demais nem chegam a ser baixados por unicode-range.
 */
import antonLatino from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import interLatino from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import copy from '../content/copy.json';

interface Props {
  title?: string;
  description?: string;
}

const { title = copy.seo.title, description = copy.seo.description } = Astro.props;
const { marca } = copy;

// JSON-LD Restaurant — a brecha de SEO local: o Brendi nao ranqueia para
// "hamburgueria Rio Verde", esta pagina pode.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: marca.nome,
  description: copy.seo.description,
  servesCuisine: 'Hambúrguer artesanal',
  /**
   * Endereço confirmado pelo dono. É este bloco que dá ao Google o que ele
   * precisa para ranquear "hamburgueria Rio Verde" — a brecha que motivou a
   * página existir, já que o Brendi não ranqueia para isso.
   *
   * Ainda falta openingHoursSpecification: só sabemos que abre às 18h, e
   * horário parcial em JSON-LD é pior que ausente — o Google mostra "fechado"
   * em dia que a casa está aberta.
   */
  address: {
    '@type': 'PostalAddress',
    streetAddress: marca.rua,
    addressLocality: marca.cidade,
    addressRegion: marca.estado,
    postalCode: marca.cep,
    addressCountry: 'BR',
    ...(marca.bairro ? { addressNeighborhood: marca.bairro } : {}),
  },
  telephone: marca.telefoneE164,
  hasMap: marca.mapaUrl,

  /**
   * Horário completo — é isto que faz o Google mostrar "aberto agora" na busca
   * por "hamburgueria Rio Verde", em vez de um card mudo.
   *
   * Segunda-feira fica de fora porque a casa fecha. Isso não estava escrito em
   * lugar nenhum: a lista de horários da loja simplesmente não tem segunda. A
   * ausência é o dado — e omitir aqui é o que faz o Google dizer "fechado" no
   * dia certo.
   */
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: marca.horario.dias,
      opens: marca.horario.abre,
      closes: marca.horario.fecha,
    },
  ],

  paymentAccepted: [...marca.pagamento.online, ...marca.pagamento.naEntrega].join(', '),
  currenciesAccepted: 'BRL',
  image: new URL('/assets/og.jpg', Astro.site).toString(),
  hasMenu: marca.cardapioUrl,
  sameAs: [marca.instagramUrl, marca.whatsappUrl],
  priceRange: '$$',
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <!--
      viewport-fit=cover: sem ele o iOS mantem a pagina dentro da safe area e
      desenha tarja preta no notch — o que transformava a Cena 2 full-bleed em
      uma cena com moldura justamente no aparelho para o qual ela foi feita.

      Com cover a area util vai ate a borda fisica, e ai o recorte passa a ser
      responsabilidade de quem encosta nas bordas: a navbar, os wraps das secoes
      e o texto da Cena 2 pagam padding de env(safe-area-inset-*). Ligar o cover
      sem esse padding jogaria a navbar por baixo do notch — os dois andam
      juntos, nunca um sem o outro.
    -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      "Esta página vai ter JavaScript?" — respondido ANTES do primeiro paint.

      Uma linha, inline e síncrona de propósito: o CSS da Cena 2 reserva o
      espaço do trilho de pin a partir deste atributo, e reserva precisa valer
      já no primeiro quadro pintado. Um módulo externo chegaria depois, e o
      espaço apareceria com a página na tela — que é exatamente o salto de
      layout que a reserva existe para eliminar.

      Sem JS o atributo nunca aparece, nenhum pin é criado e nada é reservado.
      É o que mantém o fallback sem um buraco de uma tela e meia no meio.
    -->
    <script is:inline>
      document.documentElement.setAttribute('data-js', '');
    </script>

    <link rel="preload" as="font" type="font/woff2" href={antonLatino} crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href={interLatino} crossorigin="anonymous" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />

    <!--
      og:image nao e detalhe de SEO aqui — e o caso de uso principal. O trafego
      vem do link na bio e de link colado no WhatsApp e no story; sem imagem, o
      compartilhamento aparece como caixa de texto cinza e a pagina perde a
      primeira impressao antes de ser aberta.

      A imagem e recorte do proprio hero, de proposito: o preview precisa
      parecer a pagina que o clique vai abrir.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={copy.seo.ogTitle} />
    <meta property="og:description" content={copy.seo.ogDescription} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={new URL('/assets/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.seo.ogTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/assets/og.jpg', Astro.site)} />

    <!-- Geo local — reforça o alvo "hamburgueria Rio Verde" -->
    <meta name="geo.region" content="BR-GO" />
    <meta name="geo.placename" content={marca.cidade} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <slot />

    <!--
      A MEDIÇÃO QUE JÁ ESTAVA MARCADA E NUNCA FOI LIGADA.

      Seis CTAs carregam `data-evento` desde o começo do projeto —
      cardapio-hero, cardapio-navbar, cardapio-secao, cardapio-combos,
      cardapio-final e whatsapp-onde. Alguém escolheu os pontos de medição com
      cuidado e nada lia os atributos: nenhum gtag, nenhum script, nada. O
      efeito prático era decidir tudo no escuro — sem saber se a Cena 2 ajuda
      ou atrapalha, nem qual CTA leva gente ao Brendi.

      POR QUE VERCEL ANALYTICS e não Plausible/GA:
      - a página já roda na Vercel, então não entra fornecedor novo;
      - não usa cookie nem identifica pessoa, então NÃO exige banner de
        consentimento — e um banner destruiria a primeira dobra desta página;
      - o script mora em /_vercel/insights, mesma origem: sem DNS extra e sem
        um terceiro no caminho do carregamento.

      PRECISA SER HABILITADO NO PAINEL (Project → Analytics). Enquanto não for,
      /_vercel/insights/script.js responde 404 e `window.va` nunca existe — daí
      o guarda no rastrear() abaixo. A página não quebra: ela só não mede.
    -->
    <script is:inline defer src="/_vercel/insights/script.js"></script>

    <script is:inline>
      /**
       * Delegação no document, e não um listener por CTA.
       *
       * Os alvos existem desde o HTML, mas delegar é o que mantém a medição
       * verdadeira se um CTA passar a ser renderizado depois — e custa um
       * listener em vez de seis.
       *
       * `pointerdown` e não `click`: navegação para fora (Brendi, WhatsApp)
       * frequentemente descarrega a página antes de o clique completar, e o
       * evento se perde justamente nos cliques que mais importam. pointerdown
       * dispara antes de qualquer navegação começar.
       */
      (function () {
        var jaContado = new WeakSet();

        function rastrear(evento) {
          var alvo = evento.target.closest('[data-evento]');
          if (!alvo) return;

          // Um pointerdown seguido de click no mesmo alvo é uma intenção só.
          if (jaContado.has(alvo)) return;
          jaContado.add(alvo);
          setTimeout(function () {
            jaContado.delete(alvo);
          }, 1000);

          // Sem o painel ligado, window.va não existe: sair calado é o certo,
          // um erro no console não ajudaria ninguém e sujaria o gate.
          if (typeof window.va !== 'function') return;
          window.va('event', {
            name: 'cta',
            data: { destino: alvo.dataset.evento },
          });
        }

        document.addEventListener('pointerdown', rastrear, { passive: true });
        // Teclado não emite pointerdown — sem isto, quem navega por Tab+Enter
        // não seria contado, e é justamente quem usa leitor de tela.
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') rastrear(e);
        });
      })();
    </script>
  </body>
</html>
