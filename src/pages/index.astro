  <script>
    import '../scripts/motion.js';
  </script>

  {/*
    O menu do celular. Bloco próprio, sem dependência de ordem: o módulo lê o
    header, troca atributos e volta. Se ele não rodar, os links continuam na
    tela — o CSS de painel está todo atrás de `data-menu`, que só ele escreve.
  */}
  <script>
    import { initNavMenu } from '../scripts/nav-menu.mjs';
    import { initNavSecaoAtiva } from '../scripts/nav-secao-ativa.mjs';
    initNavMenu();
    initNavSecaoAtiva();
  </script>

  <script>
    import { initCarrossel } from '../scripts/carrossel.js';
    initCarrossel();
  </script>

  {/*
    O selo de aberto/fechado recebe horário e textos daqui em vez de importar o
    copy.json: assim o módulo não arrasta a copy inteira para o bundle do
    cliente, e continua sendo testável passando um horário na mão.
  */}
  <script is:inline define:vars={{ horario: marca.horario, textos: copy.ondeEstamos.estado }}>
    window.__yardLoja = { horario, textos };
  </script>
  {/*
    Os dois módulos da seção "Onde a gente fica" dividem o mesmo <script>: cada
    bloco vira um chunk próprio no build, e uma requisição a menos no 4G do
    interior vale mais que a separação cosmética.
  */}
  <script>
    import { initEstadoLoja } from '../scripts/estado-loja.mjs';
    import { initCopiarEndereco } from '../scripts/copiar-endereco.mjs';
    initEstadoLoja(window.__yardLoja);
    initCopiarEndereco();
  </script>
</Base>

<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /**
     * A navbar e o container que mais encosta em borda: fixa, no topo, indo de
     * ponta a ponta. Com viewport-fit=cover ela passa por baixo do notch e do
     * indicador de home se nao pagar o recorte.
     *
     * Os env() sao somados ao padding que ja existia, nunca o substituem — onde
     * nao ha recorte valem 0 e o resultado e exatamente 1rem/1.5rem de sempre.
     * Esquerda e direita separadas porque em paisagem o notch fica so de um
     * lado, e um padding simetrico desperdicaria o lado limpo.
     */
    padding-block: calc(1rem + env(safe-area-inset-top)) 1rem;
    padding-left: calc(1.5rem + env(safe-area-inset-left));
    padding-right: calc(1.5rem + env(safe-area-inset-right));
    transition: background-color 0.3s ease;
  }
  .nav[data-scrolled] {
    background-color: var(--color-carvao);
  }
  .nav__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-creme);
    text-decoration: none;
    letter-spacing: 0.05em;
  }
  /**
   * O ALVO DE TOQUE TEM 44px, e o texto continua com 19px de altura.
   *
   * Estes três links eram os únicos alvos da página abaixo do mínimo de 44px —
   * `.rodape__link` e `.onde__link` já pagavam `min-height`, e ninguém tinha
   * voltado aqui. O gate mobile reprovava os três a cada rodada (Destaques
   * 77x19, Nosso hambúrguer 138x19, Onde estamos 104x19).
   *
   * `inline-flex` + `align-items: center` é o que cresce a ÁREA sem crescer a
   * linha: o texto fica do mesmo tamanho e do mesmo lugar, e o dedo ganha os
   * 44px. Padding vertical sozinho empurraria a navbar inteira para baixo.
   *
   * Os links só aparecem acima de 640px (a regra logo abaixo os remove no
   * celular), mas a navbar em PAISAGEM cabe nessa faixa — e paisagem é
   * exatamente onde o gate media a reprovação.
   */
  .nav__link {
    color: var(--color-areia);
    text-decoration: none;
    margin-inline: 0.75rem;
    font-size: 0.95rem;

    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .nav__link:hover { color: var(--color-brasa); }

  /**
   * A SEÇÃO QUE ESTÁ SENDO LIDA — marcada por `aria-current`, não por classe.
   *
   * O atributo é o que o leitor de tela anuncia como item atual; a cor e a
   * régua são a versão visual da mesma informação, e não uma segunda fonte de
   * verdade. Quem escreve o atributo é nav-secao-ativa.mjs.
   *
   * A régua é `box-shadow` e não `border-bottom`: borda mudaria a altura da
   * caixa do link, e a caixa aqui é o alvo de toque de 44px que já foi medido e
   * ajustado uma vez. Sombra pinta sem empurrar nada.
   */
  .nav__link[aria-current='true'] {
    color: var(--color-brasa);
    box-shadow: inset 0 -2px 0 0 var(--color-brasa);
  }

  /**
   * O BOTÃO DO MENU — três traços feitos de um elemento só.
   *
   * O `<span>` é o traço do meio; `::before` e `::after` são os de cima e de
   * baixo, deslocados 7px. Um elemento em vez de três porque a animação de
   * virar "X" precisa girar dois traços em torno do MESMO centro, e três
   * irmãos num flex não compartilham centro sem posicionamento absoluto de
   * qualquer jeito.
   *
   * Fora do celular ele não é escondido por `hidden` no HTML e sim por
   * `display: none` aqui: o atributo é o estado inicial, antes do JS, e some
   * assim que o script revela o botão. Quem manda no desktop é a media query.
   */
  .nav__botao {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-creme);
    cursor: pointer;
  }
  .nav__botao-traco,
  .nav__botao-traco::before,
  .nav__botao-traco::after {
    position: absolute;
    left: 50%;
    width: 22px;
    height: 2px;
    margin-left: -11px;
    background-color: currentColor;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .nav__botao-traco { top: 50%; margin-top: -1px; }
  .nav__botao-traco::before,
  .nav__botao-traco::after {
    content: '';
    left: 0;
    margin-left: 0;
  }
  .nav__botao-traco::before { top: -7px; }
  .nav__botao-traco::after { top: 7px; }

  /**
   * Aberto: o traço do meio some e os outros dois viram X sobre o centro.
   *
   * O traço do meio some por `background-color: transparent`, NÃO por
   * `opacity: 0`. Os outros dois traços são `::before` e `::after` DELE — são
   * filhos — e opacity no pai multiplica a dos filhos: o `opacity: 1` que
   * estava escrito neles não resgatava nada e o botão inteiro desaparecia no
   * exato momento em que vira o botão de fechar. Pego em print, não em código.
   */
  .nav[data-menu-aberto] .nav__botao-traco { background-color: transparent; }
  .nav[data-menu-aberto] .nav__botao-traco::before { transform: translateY(7px) rotate(45deg); }
  .nav[data-menu-aberto] .nav__botao-traco::after { transform: translateY(-7px) rotate(-45deg); }

  @media (prefers-reduced-motion: reduce) {
    .nav__botao-traco,
    .nav__botao-traco::before,
    .nav__botao-traco::after { transition: none; }
  }

  /**
   * Abaixo de 640px a navegação vira menu — e NÃO some.
   *
   * Aqui existia `.nav nav { display: none }`. O motivo escrito era real: em
   * 390px os três links empilhavam por cima do CTA e o logo quebrava em duas
   * linhas. Mas a página é vista principalmente no celular, e a conclusão de
   * "os links são atalho, não navegação essencial" escondia da maioria a única
   * forma de pular para o cardápio, para a Cena 2 ou para o endereço sem rolar
   * a página inteira com o polegar.
   *
   * SÃO DOIS ESTADOS, e o segundo depende do JS:
   *
   *   1. `.nav` sozinha — os links caem numa segunda linha por `flex-wrap`.
   *      É o layout feio que motivou o `display: none`, e é de propósito: sem
   *      JavaScript, feio e alcançável ganha de bonito e ausente.
   *   2. `.nav[data-menu]` — o atributo que só nav-menu.mjs escreve. Os links
   *      saem do fluxo, viram painel abaixo da barra, e o botão aparece. A
   *      navbar volta a ter uma linha só.
   *
   * O FUNDO SÓLIDO É FORÇADO COM O PAINEL ABERTO. A navbar só ganha cor com
   * `data-scrolled`, e no topo da página ela é transparente — um painel opaco
   * pendurado numa barra transparente deixaria os links do menu flutuando
   * sobre o hero sem nada os prendendo à barra.
   */
  @media (max-width: 639px) {
    .nav {
      flex-wrap: wrap;
      padding-left: calc(1rem + env(safe-area-inset-left));
      padding-right: calc(1rem + env(safe-area-inset-right));
    }
    .nav__logo { font-size: 1.05rem; white-space: nowrap; }
    .nav__cta { padding-inline: 1.1rem; font-size: 0.9rem; order: 2; }
    .nav__botao:not([hidden]) { display: block; order: 3; margin-left: 0.25rem; }

    /* Estado 1 — sem JS: segunda linha, largura inteira, sem sobrepor nada. */
    .nav nav {
      order: 4;
      flex-basis: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: 0 0.5rem;
    }
    .nav nav .nav__link { margin-inline: 0; }

    /* Estado 2 — com JS: painel. */
    .nav[data-menu] nav {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: none;
      flex-direction: column;
      gap: 0;
      box-sizing: border-box;
      padding: 0.25rem calc(1rem + env(safe-area-inset-left)) 0.75rem
        calc(1rem + env(safe-area-inset-right));
      background-color: var(--color-carvao);
      box-shadow: 0 12px 24px rgb(0 0 0 / 0.35);
    }
    .nav[data-menu][data-menu-aberto] nav { display: flex; }
    .nav[data-menu-aberto] { background-color: var(--color-carvao); }

    /**
     * 48px e não 44px: o painel é uma pilha de alvos vizinhos, e alvo colado em
     * alvo erra mais que alvo isolado. A régua de brasa entre um e outro é a
     * mesma linguagem das seções, e dá ao dedo uma fronteira visível.
     */
    .nav[data-menu] .nav__link {
      min-height: 48px;
      font-size: 1rem;
      border-bottom: 1px solid rgb(255 255 255 / 0.08);
    }
    .nav[data-menu] .nav__link:last-child { border-bottom: 0; }

    /**
     * No painel a régua vira barra à esquerda. Sublinhado num item de lista
     * empilhada se confunde com o separador do item de cima — e aqui já existe
     * um separador em cada linha.
     */
    .nav[data-menu] .nav__link[aria-current='true'] {
      box-shadow: inset 3px 0 0 0 var(--color-brasa);
      padding-left: 0.75rem;
    }
  }

  /**
   * BARRA FIXA DE PEDIDO — a porta do Brendi debaixo do polegar.
   *
   * "É CELULAR?" É A MESMA PERGUNTA QUE motion.js FAZ, letra por letra:
   * `(max-width: 900px), (max-height: 500px)`. Largura sozinha não responde —
   * um iPhone 13 deitado tem 844px de largura e passaria por desktop. O lado
   * curto de um aparelho não muda quando ele gira, e é essa a segunda condição.
   * Toda vez que essas duas perguntas divergiram neste projeto, alguma coisa
   * quebrou em silêncio.
   *
   * A PERGUNTA É FEITA NO CSS, e não no JavaScript, de propósito. O `ehMobile`
   * do motion.js é resolvido uma vez na carga: quem gira o aparelho depois fica
   * com a resposta velha. A media query reavalia sozinha na rotação. Ao script
   * sobra a única pergunta que independe de orientação — "o hero já saiu?".
   *
   * DEITADO ELA CONTINUA APARECENDO, e isso é escolha, não descuido: o público
   * desta landing é celular, e sumir com a porta principal porque o aparelho
   * girou seria esconder da maioria. O que muda é o respiro — em 390px de tela
   * útil cada pixel do rodapé é caro, então o padding encolhe e o que fica de
   * pé é o alvo de 48px.
   *
   * Fundo sólido em vez de backdrop-filter: por cima da barra passa desde o
   * areia dos destaques até o take em vídeo da Cena 2, e desfoque em tempo real
   * sobre vídeo é exatamente o custo de GPU que esta página não paga.
   */
  .barra-pedido {
    display: none;
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 90; /* abaixo da navbar (100): as duas nunca se encostam, mas a
                    ordem tem que ser deliberada e não sorteada pelo DOM. */

    /* Este projeto não tem reset global de box-sizing — o padding de safe-area
       abaixo somaria à largura de 100% e viraria overflow horizontal. Mesmo
       motivo já documentado em .dif__gente. */
    box-sizing: border-box;

    /**
     * SAFE AREA NO PADDING, não na margem.
     *
     * Com viewport-fit=cover (ver Base.astro) a área útil vai até a borda
     * física. No iPhone com barra de gestos, um rodapé fixo sem este env()
     * nasce POR BAIXO dela: o botão aparece inteiro e o toque não chega —
     * defeito que não se vê em print nenhum.
     *
     * O fundo continua encostando na borda de baixo (é o env() no padding que
     * garante isso), então não sobra faixa clara entre a barra e o aparelho.
     */
    padding-block: 0.6rem calc(0.6rem + env(safe-area-inset-bottom));
    padding-left: calc(1rem + env(safe-area-inset-left));
    padding-right: calc(1rem + env(safe-area-inset-right));

    background-color: var(--color-carvao);
    border-top: 1px solid rgb(232 220 200 / 0.12);

    /**
     * ESCONDIDA É `display: none`, e isso foi MEDIDO antes de ser escolhido.
     *
     * A primeira versão usava `visibility: hidden`, que já resolve Tab e leitor
     * de tela. Mas `visibility` mantém a caixa no layout, e o `audit-page.mjs`
     * filtra elemento oculto por `offsetParent !== null` — que ignora
     * `visibility`. Resultado medido: `semJs.ctasVisiveis` subiu de 6 para 7,
     * contando um botão que ninguém vê. Cegar o instrumento para caber a
     * feature é pior do que não ter a feature; a barra some de verdade.
     *
     * O estado de chegada continua sendo só `translateY(0)`: ele existe
     * estático, sem depender de animação nenhuma. Sob `prefers-reduced-motion`
     * a regra global de tokens.css zera a duração e a barra simplesmente
     * APARECE — sem deslizar, mas nunca ausente.
     *
     * `allow-discrete` + `@starting-style` são o que deixa `display` participar
     * da transição: sem eles o navegador troca `none`/`block` de uma vez e o
     * transform não teria de onde partir. Onde não houver suporte, a declaração
     * de `transition` é descartada inteira e a barra aparece de estalo — que é
     * exatamente o mesmo estado final, só sem o deslize.
     *
     * `transform` e nada mais: a barra é `fixed`, não ocupa espaço no fluxo e
     * não desloca um pixel de layout ao entrar. O gate deste projeto mede
     * EMPURRÃO, e o empurrão aqui é zero por construção — verificado em 0px.
     */
    transform: translateY(100%);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      display 0.28s allow-discrete;
  }
  /* Largura inteira: num rodapé de celular o alvo certo é a faixa toda, não uma
     pílula centrada que obriga a mirar. 48px e não os 44px do mínimo — 44 é o
     piso de auditoria, e este é o botão mais importante da página. */
  .barra-pedido__cta {
    width: 100%;
    min-height: 48px;
    font-size: 1.05rem;
  }

  /**
   * O `display: block` mora DENTRO da media query, e é só ele que faz a barra
   * existir. No desktop o script continua escrevendo `data-visivel` — deixá-lo
   * cego para a orientação é o que mantém a rotação correta — e a media query
   * simplesmente não lhe dá corpo.
   */
  @media (max-width: 900px), (max-height: 500px) {
    .barra-pedido[data-visivel] {
      display: block;
      transform: translateY(0);
    }
    @starting-style {
      .barra-pedido[data-visivel] { transform: translateY(100%); }
    }
  }

  /* Em paisagem o rodapé disputa 390px de altura com a página inteira. */
  @media (max-height: 500px) {
    .barra-pedido { padding-block: 0.35rem calc(0.35rem + env(safe-area-inset-bottom)); }
  }

  .hero {
    position: relative;
    min-height: var(--cena-altura);
    display: grid;
    place-content: center;
    text-align: center;
    padding: 7rem 1.5rem 4rem;
    background-color: var(--color-carvao);
    overflow: hidden;
  }
  .hero__conteudo {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.25rem;
    justify-items: center;
  }
  /* Overlay carvão por cima da foto: o texto precisa vencer o contraste
     independente de como a foto for iluminada. */
  .hero__foto {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
    will-change: transform;
  }

  /**
   * NO CELULAR, O HERO MOSTRAVA GRELHA E MESA — E MAIS NADA.
   *
   * O arquivo é 1376x768, deitado. Num aparelho em pé o `cover` escala pela
   * ALTURA (844/768 = 1,10), a imagem vira 1513px de largura e a tela de 390px
   * mostra **25,8% dela**, centrada. Medido. E o que mora nesses 25,8% do
   * centro é a chaminé preta e a grelha: o hambúrguer montado está a ~75% da
   * largura, na bandeja de cobre à direita, e caía inteiro fora do quadro.
   *
   * O segundo fator é a opacidade. Os 0,45 do desktop funcionam porque lá a
   * cena inteira aparece — sobra pôr do sol, fumaça âmbar e o produto. No
   * recorte do celular, 45% de uma faixa que já é quase preta dá preto.
   *
   * As duas correções são de CSS e custam ZERO byte de imagem — a alternativa,
   * um recorte 9:16 próprio, não existe neste material: o original só tem 768px
   * de altura, então um crop 9:16 sairia com 432px de largura e seria upscale
   * de 2,7x num aparelho DPR3. Take vertical de verdade exigiria gerar de novo,
   * e a regra deste projeto é fechar a composição inteira num modelo só.
   *
   * `object-position: 86%` traz a bandeja e o hambúrguer para o quadro. O `46%`
   * vertical sobe um pouco o corte, para o produto não encostar na borda de
   * baixo. E o texto sai do centro: ele vai para o alto, onde a foto é escura
   * de origem, e devolve a metade de baixo ao produto.
   */
  @media (max-width: 639px) {
    .hero {
      place-content: start center;
      padding-top: 7.5rem;
      padding-bottom: 3rem;
    }
    /**
     * O DESLOCAMENTO SÓ VALE PARA QUEM RECEBEU O ARQUIVO DEITADO.
     *
     * Com `hero-vertical.webp` no ar, o recorte já vem pronto do arquivo e
     * mover o `object-position` jogaria o hambúrguer para fora de novo. O
     * atributo é escrito pelo Astro quando o recorte existe, então o CSS
     * pergunta a mesma coisa que o `<picture>` decidiu — e não um segundo
     * palpite sobre qual arquivo chegou.
     */
    .hero__foto:not([data-hero-vertical]) {
      object-position: 86% 46%;
    }
    .hero__foto {
      opacity: 0.92;
    }

    /**
     * O VÉU DE LEITURA VIRA GRADIENTE, e não uma cortina uniforme.
     *
     * Escurecer tudo por igual foi o que apagou o hambúrguer. Aqui o carvão é
     * denso em cima, onde está a headline e a foto já é escura, e quase se
     * dissolve embaixo, onde está o produto. O texto continua com fundo para
     * vencer o contraste; o hambúrguer, com luz para existir.
     *
     * `z-index: 1` — entre a foto (0) e o conteúdo (2).
     */
    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: linear-gradient(
        to bottom,
        rgb(20 12 6 / 0.92) 0%,
        rgb(20 12 6 / 0.82) 34%,
        rgb(20 12 6 / 0.45) 58%,
        rgb(20 12 6 / 0.2) 100%
      );
    }
  }
  .hero__sobretitulo {
    color: var(--color-brasa);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }
  .hero__titulo {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .hero__destaque { color: var(--color-brasa); }
  .hero__subtitulo {
    max-width: 34rem;
    margin-inline: auto;
    color: var(--color-areia);
    line-height: 1.6;
  }

  .claro { background-color: var(--color-areia); color: var(--color-carvao); }

  /**
   * AS DUAS PESSOAS SAÍRAM DA GRADE — VIRARAM CAMADA POR CIMA, NÃO COLUNA AO
   * LADO.
   *
   * Quatro arranjos foram medidos nesta seção, nesta ordem:
   *
   *   1. Coluna lateral pura (`minmax(9rem,1fr) minmax(0,52rem) …`). A foto
   *      cabia dentro da lateral e por isso era o que sobrava da tela: 144x216
   *      em 1024, 304x457 em 1440. Pequena demais.
   *   2. Faixa embaixo (título e pilares em cima, o par numa linha própria).
   *      Resolvia o tamanho — 497x745 em 1440 — mas o dono achou o par embaixo
   *      estranho e pediu o lateral de volta.
   *   3. Grade de três colunas (`esq miolo dir`) com a foto dimensionada pela
   *      ALTURA da janela, transbordando 72px sobre o miolo. Resolvia o
   *      tamanho, mas a coluna lateral ainda tirava largura do miolo — o
   *      cliente chamou isso de "espremido": em 1024x768 o miolo sobrava só
   *      184px de largura útil (2x(308-72) pagos pelas colunas).
   *   4. Este. As duas figuras saem do grid e viram `position: absolute`,
   *      ancoradas nas bordas de `.diferenciais` (que segue `position:
   *      relative`). O miolo (`.claro__wrap`) volta a ter a largura inteira da
   *      seção, como qualquer outro `.claro`, e as fotos passam a ser camada
   *      visual sobre ele — não vizinhas de grade.
   *
   * `--gente-larg` PASSOU POR TRÊS RODADAS DE MEDIÇÃO, E A SEGUNDA ERRADA POR
   * OTIMIZAR A COISA ERRADA.
   *
   * Antes o segundo teto reservava 23rem de texto dentro da própria grade
   * (`(100vw - 25.5rem) / 2`) — sem sentido agora que não há grade para
   * reservar nada dentro dela.
   *
   * RODADA 1 — sem teto nenhum: medido em 1280x800 a foto ficava com 432px de
   * largura contra 96px de margem fora do wrap, 336px dela caindo POR CIMA dos
   * cartões de pilar, cobrindo o primeiro por completo.
   *
   * RODADA 2 — o ERRO: prender `--gente-larg` à margem que sobra fora do
   * `.claro__wrap` (`margem-wrap + avanço`). Isso zerava a sobreposição, mas
   * era o problema errado a resolver — o pedido nunca foi "zero sobreposição",
   * foi "não espremer o miolo" (esse já estava resolvido só de tirar a grade).
   * `--gente-margem-wrap` só existe acima de 1088px (68rem, o teto do
   * `.claro__wrap`); ABAIXO disso ela é zero e a foto degenerava para só o
   * avanço — 24px, uma pessoa de 24×36px boiando no meio de uma coluna vazia.
   * E essa faixa (901–1088px de largura, sempre com altura acima de 500px —
   * abaixo disso já é o layout mobile, e o par vai para o fim da seção) não é
   * rara: iPad em paisagem, Surface, janela não maximizada em monitor 1080p
   * caem nela — celular é o cliente principal desta landing, mas aqui quem
   * usa este código é o desktop.
   *
   * RODADA 3 — ESTE. Dois mecanismos independentes, não um só:
   *
   *   `--gente-larg-desejada`: o tamanho que a foto TERIA dimensionado só pela
   *   janela, sem olhar para o conteúdo — `max(18vw, altura × 0,92 × 5/6)`. O
   *   piso em `18vw` é o que impede a degeneração da Rodada 2: mesmo numa
   *   janela baixa E larga, onde o termo de altura murcha, a foto nunca fica
   *   menor que 18% da largura da tela. Na prática o termo de altura quase
   *   sempre vence (é bem maior que 18vw em janelas normais); o piso só entra
   *   em janelas curtas de propósito.
   *
   *   `--gente-larg-segura`: o quanto a foto pode avançar SEM tocar no ÍCONE
   *   do primeiro/último pilar — `margem-wrap + avanço + 1,4rem` (o padding
   *   horizontal do `.pilar`, ver a regra dele mais abaixo). Isto é o cálculo
   *   de "onde o ícone começa", não "onde a margem acaba": o resultado pousa
   *   exatamente na borda esquerda do ícone, tocando sem cobrir — testado em
   *   1280x800, ver `.tmp-medir-dif.mjs`.
   *
   *   `--gente-larg` é o MENOR dos dois — a foto nunca é maior do que o
   *   necessário para não tocar o ícone —, com um piso absoluto de 120px para
   *   nunca repetir a degeneração da Rodada 2. Esse piso é o único caso em que
   *   a foto ainda toca o ícone (medido: na faixa 901–1024px, onde a margem
   *   soma zero, `--gente-larg-segura` cai a ~70px e o piso de 120px vence —
   *   sobram uns 50px cobrindo o ícone e o começo do título). É a exceção que
   *   o pedido aceita explicitamente: nunca abaixo de ~120px de largura, ainda
   *   que isso custe o ícone nessa faixa específica.
   *
   * `--gente-avanco` SUBIU DE 1,5rem PARA 3rem, e o padding do `.claro__wrap`
   * subiu JUNTO (ver a regra dele mais abaixo) — os dois sempre andam
   * juntos, é o próprio motivo de existir do avanço. 1,5rem fazia a foto
   * morrer bem na borda do cartão (zero sobreposição, mas também zero
   * avanço visível); 3rem dobra a faixa em que a foto cruza a borda da
   * seção sem tocar em nada, igual ao espírito do avanço de 72px original,
   * só que sem repetir o erro de ele ser maior que o padding do wrap.
   *
   * A margem em si usa `100%` e não `100vw`. `100vw` inclui a barra de
   * rolagem (o vazamento clássico de `100vw`); `.claro__wrap` centraliza pela
   * largura REAL do container, que exclui a barra. `100%`, resolvido no
   * contexto de `width` (a propriedade que consome `--gente-larg`), usa a
   * largura real do PRÓPRIO `.diferenciais` — a mesma caixa em que
   * `.claro__wrap` centraliza, então os dois números concordam.
   */
  .diferenciais {
    position: relative;
    overflow: visible;

    /* Altura da caixa. 88vh e não 100vh porque a caixa inteira tem de caber na
       janela: passando disso ninguém vê a pessoa inteira de uma vez, e "mostrar
       tudo" volta a falhar — por rolagem em vez de recorte. O teto de 56rem é
       para monitores altos, onde 88vh pediria uma foto de 1000px e a seção
       viraria só rolagem. */
    --gente-caixa: min(88vh, 56rem);

    /* QUANTO A FOTO AVANÇA SOBRE O MIOLO E QUANTO O `.claro__wrap` RECUA DA
       BORDA — os dois valem o MESMO número de propósito (ver a regra do wrap
       mais abaixo e o comentário grande acima).

       O TERMO `max()` É O QUE FAZ O PISO DE 120px PARAR DE COMER TEXTO. Medido
       em 1024x768: com o avanço fixo em 3rem, `--gente-larg-segura` valia
       0 + 48 + 22,4 = 70,4px, o piso de 120px vencia o `min()` e a figura
       entrava 49,6px cartão adentro. O comentário antigo chamava isso de "uns
       50px cobrindo o ícone e o começo do título" e aceitava — mas a medição
       com o par novo mostra a figura indo de 0 a 120px contra um cartão que
       começa em 48px: são 72px sobre TEXTO CORRIDO, não sobre o ícone. Foto
       tampando palavra não é exceção aceitável, é defeito de leitura. (O
       defeito é anterior a esta rodada e independe da âncora vertical: com a
       foto centrada ele comia o corpo do pilar 01, plantada come o do 03.)

       Em vez de baixar o piso — que reabriria a degeneração da Rodada 2, a
       pessoa virando lasca de 24px na borda — quem cede é o MIOLO: onde não há
       margem sobrando fora do wrap, o avanço cresce até o exato ponto em que
       `--gente-larg-segura` alcança os 120px do piso, e o wrap recua junto
       (é a regra logo abaixo, e é o motivo de o avanço existir). A conta é a de
       `--gente-larg-segura` resolvida para o avanço: 120px - 1,4rem - margem.

       É CONTÍNUO, NÃO UM DEGRAU DE BREAKPOINT. Onde a margem do wrap já paga a
       conta sozinha (acima de ~1187px) o `max()` devolve os 3rem originais e
       nada muda; abaixo disso o avanço sobe suavemente até 97,6px em 1088px e
       segura ali. Nenhuma faixa fica sem foto e nenhuma fica com foto sobre
       texto. Verificado em 901, 1024, 1280, 1440 e 1920 — abaixo de 901px (ou
       de 500px de altura) quem manda é o layout mobile, não esta conta — ver
       a tabela no comentário do `srcset`. */
    --gente-avanco: max(3rem, calc(120px - 1.4rem - var(--gente-margem-wrap)));

    /* A margem que sobra FORA do `.claro__wrap` (68rem) em cada lado, medida
       contra a largura REAL do próprio `.diferenciais` (`100%`, não `100vw`
       — ver o comentário grande acima). Zero quando a janela é mais estreita
       que o próprio wrap — é o caso de 901–1088px (sempre com altura acima de
       500px), onde só o mecanismo de segurança abaixo (não este) evita a
       degeneração. */
    --gente-margem-wrap: max(0px, calc((100% - 68rem) / 2));

    /* O TAMANHO QUE A FOTO TERIA SÓ PELA JANELA, ignorando onde o conteúdo
       está. `18vw` é o piso contra janelas curtas E largas, onde o termo de
       altura murcharia sozinho. 0,92 é a folga do parallax: a caixa fica 8%
       mais alta do que a proporção do arquivo pede, o `contain` encaixa pela
       largura e sobram 4% de altura em cada ponta — exatamente o que o
       deslocamento de ±3% consome sem descobrir moldura. Ver
       `dif-gente-parallax-inteira`.

       `5 / 6` É A PROPORÇÃO DO ARQUIVO e mudou junto com ele: o par novo é
       recorte alinhado pela cabeça, 1020x1224, e não mais 2:3. O termo tem de
       ser a proporção real, senão a folga de 8% deixa de ser 8% — é dela que
       sai o passo do parallax. O teto de 56rem em `--gente-caixa` prende este
       termo em ~687px nas telas altas (eram ~549px em 2:3), e na prática só
       manda em monitor muito largo: abaixo disso quem vence o `min()` é
       sempre `--gente-larg-segura`. */
    --gente-larg-desejada: max(18vw, calc(var(--gente-caixa) * 0.92 * 5 / 6));

    /* O QUANTO A FOTO PODE AVANÇAR SEM TOCAR O ÍCONE do pilar mais próximo —
       margem fora do wrap, mais o avanço, mais o padding horizontal do
       `.pilar` (1,4rem — é onde o ícone começa, não onde o cartão começa).
       Ver o comentário grande acima para os números medidos. */
    --gente-larg-segura: calc(
      var(--gente-margem-wrap) + var(--gente-avanco) + 1.4rem
    );

    /* A foto nunca é maior do que o necessário para não tocar o ícone (o
       menor dos dois termos), com um piso de 120px para nunca degenerar —
       ver o comentário grande acima para onde esse piso ainda toca o ícone. */
    --gente-larg: max(120px, min(var(--gente-larg-desejada), var(--gente-larg-segura)));

    /* A SEÇÃO NUNCA FICA MAIS BAIXA QUE A FOTO. As figuras saíram do fluxo
       (`position: absolute`) e por isso não empurram mais a altura da seção
       como um item de grid empurraria a linha — sem isto, em telas altas
       (`--gente-caixa` perto de 896px) a foto ultrapassaria o topo da seção
       para dentro do hero, ou o pé para dentro do carrossel seguinte. Medido:
       sem `min-height`, em 1440x900 a seção mede ~610px de conteúdo contra uma
       caixa de 792px — 91px de vazamento vertical de cada lado. Com
       `min-height`, a seção cresce para caber a foto inteira e a rolagem
       absorve a diferença, exatamente como o auto-sizing de linha do grid
       antigo fazia sem precisar disto. Ver o comentário grande acima para
       quanto isso sobra de vazio quando a foto é mais baixa que o conteúdo. */
    min-height: var(--gente-caixa);
  }

  /**
   * O PADDING DO MIOLO CRESCE JUNTO COM O AVANÇO DA FOTO.
   *
   * `--gente-avanco` (3rem) é o quanto a foto pode cruzar a borda da seção
   * sem tocar no cartão — mas só funciona se o cartão de fato começar 3rem
   * depois da borda. Sem esta regra o `.claro__wrap` usaria o padding padrão
   * de qualquer `.claro` (1,5rem) e a conta de `--gente-larg-segura` mediria
   * uma distância que não existe de verdade, reabrindo a cobertura de ícone
   * que este número inteiro existe para evitar.
   *
   * Só desktop: no celular as figuras saem do fluxo absoluto e vão para o fim
   * da seção (ver o bloco `(max-width: 900px), (max-height: 500px)` mais
   * abaixo), onde este padding extra não tem função — lá o wrap volta ao
   * padding padrão.
   */
  .diferenciais > .claro__wrap {
    padding-left: calc(var(--gente-avanco) + env(safe-area-inset-left));
    padding-right: calc(var(--gente-avanco) + env(safe-area-inset-right));
  }

  /**
   * O `<li>` QUE SÓ EXISTE PARA O `<ul>` ACEITAR A FIGURA — e desaparece em
   * QUALQUER largura, não só no desktop.
   *
   * As duas figuras precisam ser filhas de `.diferenciais` para o
   * `position: absolute` ancorar nela (é o container de posicionamento mais
   * próximo) — mas também precisam estar dentro de `.pilares` para virarem
   * item de ponta do trilho no celular (ver o bloco `(max-width: 900px),
   * (max-height: 500px)` mais abaixo). `display: contents` resolve as duas: o
   * `<li>` some da árvore de caixas e a `<figure>` (`.dif__gente`) passa a
   * contar como se fosse filha direta de `.pilares` para efeito de layout —
   * `position: absolute` continua resolvendo o container pelo ancestral
   * posicionado mais próximo (`.diferenciais`), não pela profundidade do DOM,
   * então o desktop nem percebe a mudança. No celular é essa promoção que
   * deixa `.dif__gente` virar item de flex de verdade dentro do trilho.
   *
   * ANTES ISTO ERA UM `<div class="dif__par">` fora do `<ul>`, que virava
   * `display: flex` no celular para empilhar as duas fotos lado a lado abaixo
   * dos cartões. Essa versão saiu porque deixava ~330px de faixa morta no fim
   * da seção (medido: 112px de vão + ~172px de foto + 40px de sobra) — a
   * causa do "espaço enorme" que o dono via empurrando o carrossel de mais
   * pedidos para baixo. Ver o comentário grande antes da seção.
   */
  .pilar-figura {
    display: contents;
  }

  /**
   * AS FIGURAS SAEM DO FLUXO E ANCORAM NAS BORDAS DE `.diferenciais`.
   *
   * `left: 0` / `right: 0` fazem cada uma encostar na borda EXTERNA da seção e
   * crescer para dentro — o mesmo motivo de sempre: invertido, o excedente
   * cresceria para FORA da tela e viraria vazamento horizontal. Como
   * `.diferenciais` não tem padding próprio, essas bordas são as bordas reais
   * da seção, e `--gente-larg` já é a largura final — não há mais coluna de
   * grid para "pagar" com `--gente-larg - --gente-avanco`.
   *
   * `top: 50%` + `translateY(-50%)` centralizam na vertical dentro da seção
   * (que o `min-height` acima garante ser alta o bastante para caber a foto
   * inteira sem vazar para hero ou carrossel).
   */
  .dif__gente {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    height: var(--gente-caixa);
    width: var(--gente-larg);

    /* A FOTO PASSA POR CIMA DOS CARTÕES, ENTÃO NÃO PODE COMER CLIQUE.
       A figura não tem link nem alvo de toque; sem isto o canto do primeiro e
       do último cartão de pilar ficariam sob uma área que engole o ponteiro,
       e o trilho de teclado dos pilares perderia o clique de foco. */
    pointer-events: none;
    /* Acima do miolo. Sendo `position: absolute`, a ordem no DOM já não
       garante nada sozinha — o z-index é quem decide. */
    z-index: 3;

    margin: 0;
    overflow: hidden;
    /* Âncora do véu de revelação (::after). Qualquer valor diferente de
       `static` serve — já é `absolute` pelo posicionamento acima. */
    /**
     * FUNDO TRANSPARENTE, e é isso que faz a máscara funcionar.
     *
     * A caixa é 8% mais alta do que a foto (a folga do parallax). Com fundo
     * pintado, essa sobra desenha uma tira sólida acima e abaixo da pessoa e a
     * peça volta a ter cara de retângulo colado. Transparente, a sobra é areia
     * e a foto termina onde a pessoa termina. Isto agora vale também no
     * celular — ver o bloco `(max-width: 900px), (max-height: 500px)` mais
     * abaixo.
     */
    background-color: transparent;

    /* Declarado AQUI e não herdado: este projeto não tem reset global de
       box-sizing (conferido — `box-sizing` não aparece em nenhum lugar de
       src/). Sem isto o padding de safe-area abaixo SOMA à largura da coluna e
       vira overflow horizontal na paisagem com notch, que é exatamente o
       defeito que o padding existe para não causar. */
    box-sizing: border-box;
  }
  /**
   * `env(safe-area-inset)` como padding e não como margem: a imagem recua da
   * faixa do notch sem que a caixa em si (âncora do `left`/`right` acima)
   * mude de tamanho.
   *
   * MEDIDO na auditoria mobile: em paisagem com notch o inset esquerdo é 47px
   * contra 422px de coluna — 11,1% da figura. Com o par novo isso importa
   * ainda mais do que importava: as fotos são recorte, o assunto encosta nas
   * quatro bordas do arquivo e ali não há sobra nenhuma para o aparelho comer.
   * É exatamente onde estão a mão e a lata de Coca-Cola.
   *
   * Só nas bordas externas de cada figura. A borda interna encosta no areia e
   * ali não existe notch.
   */
  .dif__gente--esq { left: 0; padding-left: env(safe-area-inset-left); }
  .dif__gente--dir { right: 0; padding-right: env(safe-area-inset-right); }

  /**
   * A `mask-image` SAIU, E TIRÁ-LA É O CONSERTO — não uma simplificação.
   *
   * Ela existia por um motivo que morreu: o par antigo era foto de estúdio de
   * fundo PRETO, um retângulo cheio sobre o areia da seção, e o dono pediu "uma
   * box-shadow combinando as cores para não parecer que foi sobreposto".
   * Testados os dois caminhos, ficou a máscara e não a sombra — um degradê de
   * 5% no topo e 3% nas laterais dissolvia o preto no areia e a peça deixava de
   * ter borda. Os números eram medidos: caíam todos em fundo preto puro, e o pé
   * não tinha degradê nenhum porque o thobe encostava na borda de baixo.
   *
   * O par de 03/09 é RECORTE COM ALPHA. Não existe mais retângulo para
   * dissolver — o alpha já termina a figura onde a pessoa termina — e os mesmos
   * números passaram a cair EM CIMA DO ASSUNTO: medido no arquivo novo, o
   * assunto ocupa 1020x1224 de um quadro de 1020x1224, isto é, encosta nas
   * quatro bordas. Os 5% de topo comeriam o agal e o alto do keffiyeh; os 3%
   * laterais comeriam o cotovelo da esquerda (que toca a borda na foto da
   * placa) e a beirada do cartaz. Era degradê apagando produto.
   *
   * O QUE SOBROU DO PEDIDO ORIGINAL continua atendido, e melhor: sem fundo, não
   * há emenda para combinar cor nenhuma. A peça não parece colada porque não
   * tem borda, não porque a borda foi disfarçada.
   */

  /**
   * `contain` E NÃO `cover` — a foto inteira, e o dono foi direto ao ponto:
   * "tampou metade das imagens, quero que mostre a imagem toda".
   *
   * A conta explica o estrago. A caixa lateral do desktop é MUITO mais estreita
   * que a foto (mede 246x792 em 1440x900, razão 0,31, contra 0,833 do arquivo).
   * Com `cover`, o navegador preenche pela largura e joga fora a maior parte do
   * quadro — não havia `object-position` que salvasse, só escolhia QUAL metade
   * seria perdida. Era escolher entre o hambúrguer e a placa.
   *
   * `contain` cabe a foto inteira e sobra espaço em cima e embaixo. Com o par
   * antigo isso não abria buraco porque a figura tinha
   * `background-color: var(--color-carvao)` e o fundo da foto era preto de
   * estúdio — dois pretos quase iguais se encostando. Com o par novo o fundo
   * não existe: a sobra é transparente e o que aparece é o areia da própria
   * seção, que é o certo. O `background-color: transparent` declarado acima é o
   * que faz isso valer.
   *
   * No celular isto não muda nada: lá a figura tem a MESMA proporção do arquivo
   * (5:6), então `contain` e `cover` desenham o mesmo quadro.
   */
  .dif__gente img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }
  /**
   * NÃO HÁ MAIS `object-position` POR LADO, e a ausência é o conserto.
   *
   * Enquanto o desktop usava `cover`, cada foto precisava de um número próprio
   * dizendo qual pedaço sobreviveria ao corte — 44% de um lado, 50% do outro,
   * e ainda assim o hambúrguer da esquerda saía pela metade. Com `contain` a
   * pergunta deixa de existir: aparece tudo, e não há o que ancorar na
   * HORIZONTAL. Por isso os dois lados usam o mesmo valor.
   *
   * O 100% VERTICAL É QUE AS DUAS PISEM NO CHÃO DA SEÇÃO. No desktop a caixa é
   * muito mais alta do que a foto desenhada — ela é limitada pela largura, e em
   * 1440x900 são 792px de caixa para 295px de figura. Centrada (o `50%`
   * anterior), a pessoa boiava no meio da seção com o corte do quadril
   * acontecendo no ar, e corte no ar lê como membro decepado. Encostada no pé
   * da caixa, o mesmo corte cai na borda da seção e passa a ler como quadro: a
   * pessoa continua para fora da página, que é a convenção de qualquer foto
   * sangrada. De quebra o alinhamento deixa de ser com a primeira fileira de
   * pilares e passa a ser com a seção inteira.
   *
   * No celular isto não muda NADA, e por construção: lá a caixa tem o mesmo
   * `aspect-ratio: 5/6` do arquivo, o `contain` preenche os dois eixos e não
   * sobra folga para ancorar. O valor é inócuo por lá — não precisa de exceção.
   *
   * Se algum dia o desktop voltar a `cover`, os números por lado precisam
   * voltar JUNTOS e recalculados para as fotos da vez — eles descreviam onde
   * estava o assunto em cada quadro, e quadro novo muda tudo.
   */

  /**
   * O `filter: sepia()` SAIU PELO MESMO MOTIVO QUE A MÁSCARA — perdeu o objeto.
   *
   * Ele era `sepia(0.12) saturate(1.05) hue-rotate(-4deg)` e existia para uma
   * coisa só: o fundo de estúdio destas fotos era `#020202`, preto neutro, e o
   * carvão da casa é `#140c06`, marrom quente. Encostados na página — e eles se
   * encostavam, porque a Cena 2 termina em carvão logo acima desta seção — o
   * olho lia dois pretos diferentes e a seção parecia montada com peças de
   * origens distintas. O valor era mínimo de propósito, para aquecer o preto
   * sem amarelar o thobe branco.
   *
   * Sem fundo, o filtro não tem mais preto para corrigir: sobra só o efeito
   * colateral que ele fugia de causar. Aplicado num recorte, `sepia` age
   * exatamente sobre o thobe branco (que vira creme) e sobre o vermelho do
   * keffiyeh (que perde saturação) — as duas coisas que são o assunto. E a
   * Coca-Cola tem vermelho de marca; deslocar o matiz dela é mexer no logotipo
   * de outra empresa dentro da nossa página.
   *
   * A integração com o areia é feita agora pela luz da própria foto, que é
   * clara e quente, e não por correção em cima dela.
   */

  /**
   * AS DUAS PESSOAS GANHARAM PARALLAX E REVELAÇÃO — sem uma linha de JS.
   *
   * `animation-timeline: view()` roda no compositor e já é o instrumento que
   * esta página usa para parallax fora da Cena 2 (ver tokens.css). GSAP aqui
   * não se justifica: ele existe no projeto para pin + scrub de sete camadas, e
   * um elemento que anda mais devagar que a rolagem é exatamente o que a
   * primitiva nativa faz. Onde ela não existe, o @supports não aplica nada e as
   * fotos ficam paradas — nunca quebradas.
   *
   * O PEDIDO ERA yPercent -12 COM scale 1.15 -> 1, E ISSO CORTA A PESSOA.
   * A figura tem `overflow: hidden` e a imagem entra por `contain`: o que sobra
   * de folga vertical é o 0,08 embutido em `--gente-larg-desejada` (a caixa é
   * 8% mais alta do que a proporção do arquivo pede), ou seja 4% por ponta.
   * ±3% de deslocamento passa com 1% de folga; qualquer valor maior empurra a
   * imagem para fora da caixa e o `overflow` decepa o agal no alto ou a barra
   * do thobe no pé. Com o par antigo o excesso aparecia como faixa de carvão
   * porque a figura tinha fundo pintado; com recorte não há faixa nenhuma —
   * some pedaço de pessoa, que é pior e menos óbvio de notar.
   */
  /**
   * O VÉU VIROU AREIA, E ERA CARVÃO — trocar a cor é o que salva a revelação.
   *
   * O véu é um retângulo que cobre a figura e desce para descobri-la. Com a
   * foto de fundo preto, carvão era a cor certa: o véu tinha praticamente a
   * mesma cor do que estava cobrindo, e a revelação lia como a foto surgindo.
   *
   * Com recorte sobre areia, um retângulo de carvão passa a ser a coisa mais
   * escura da seção inteira descendo por cima de duas pessoas — deixa de ser
   * revelação e vira tarja. A cor do véu tem de ser a cor do que está ATRÁS da
   * figura, e atrás dela está o fundo de `.claro`, que é o areia. Assim o véu é
   * invisível e o que se vê é só a pessoa entrando de cima para baixo.
   *
   * A `mask-image` que antes suavizava a borda do véu saiu junto com o fundo
   * preto (ver acima). Ela não faz falta aqui: um retângulo de areia sobre
   * areia não tem borda para suavizar.
   */
  .dif__gente::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-areia);
    pointer-events: none;
    /**
     * ESTADO DE REPOUSO É REVELADO, e é isso que faz reduced-motion funcionar.
     *
     * O véu nasce FORA do caminho. Quem recusa movimento, quem está num browser
     * sem scroll-driven animation e quem tem JS desligado veem a foto inteira,
     * porque nada precisa rodar para tirar o véu — ele já saiu. O inverso
     * (nascer cobrindo e depender da animação) deixaria a foto preta nesses
     * três casos, que é o defeito clássico de revelação por scroll.
     */
    transform: translateY(101%);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /**
       * O DESKTOP USA O PARALLAX SEM ESCALA. Com `contain`, qualquer `scale`
       * acima de 1 faz a foto crescer além da caixa e volta a cortar — seria
       * desfazer, na animação, o que o `object-fit` acabou de consertar.
       */
      .dif__gente img {
        animation: dif-gente-parallax-inteira linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      .dif__gente::after {
        animation: dif-gente-veu linear both;
        animation-timeline: view();
        /**
         * `cover` e não `entry`, e o motivo é aritmético: no desktop a figura
         * tem a altura da seção (876px medidos em 1440x900) e `entry 100%` só
         * existe quando o elemento CABE inteiro na viewport. Numa janela mais
         * baixa que a figura esse ponto nunca chega, a animação nunca completa
         * e o véu ficaria parado no meio da foto — preto sobre metade da
         * pessoa. `cover` mede a travessia inteira e 18% dela sempre acontece.
         */
        animation-range: cover 0% cover 18%;
      }
    }
  }

  /**
   * ±3% E NÃO MAIS ±6%, e o número saiu da folga, não do gosto.
   *
   * A porcentagem de `translate` é do tamanho do ELEMENTO (a caixa), e a folga
   * disponível é 4% da caixa em cada ponta — os 8% que a largura de 92% deixou
   * sobrar em `.dif__gente`. ±3% da caixa contra 4% de folga: em 1440x900 são
   * ±24px de deslocamento dentro de 32px de sobra, 8px de margem em cada ponta.
   *
   * No arranjo antigo a caixa era a coluna inteira (905px de altura contra uma
   * foto de 457px), a folga era de 224px por ponta e ±6% cabia com sobra de
   * sobra. A caixa nova é justa de propósito — foi assim que a foto cresceu — e
   * o passo teve de encolher junto. Ultrapassar 4% descobre carvão no topo ou
   * no pé da foto.
   */
  @keyframes dif-gente-parallax-inteira {
    from {
      transform: translate3d(0, -3%, 0);
    }
    to {
      transform: translate3d(0, 3%, 0);
    }
  }

  /* O `dif-gente-parallax` com escala (1,16 → 1,08) foi REMOVIDO daqui. Ele era
     o parallax do celular e existia para a época do `object-fit: cover`, onde a
     escala extra era sobra escondida. Hoje as duas larguras usam
     `dif-gente-parallax-inteira` — ver o bloco `(max-width: 900px), (max-height:
     500px)` mais abaixo. */

  /* O véu desce e descobre a foto de cima para baixo — a mesma direção em que
     a figura entra na tela quando a pessoa rola. Subir revelaria pelo pé, que
     é contra o movimento e lê como falha de carregamento. */
  @keyframes dif-gente-veu {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(101%);
    }
  }

  /**
   * CELULAR — as duas entram no trilho, uma em cada ponta.
   *
   * Nada de `display: none`: o público desta landing é celular, e esconder no
   * celular o que existe no desktop é esconder da maioria. O que muda é o
   * papel — de camada sobreposta para item de ponta do próprio trilho de
   * pilares (ver o comentário grande antes da seção, e o de `.pilar-figura`
   * mais acima, para o histórico da versão anterior — um `<div>` em flex
   * embaixo dos cartões — e por que ela saiu: ~330px de faixa morta medidos
   * no fim da seção).
   *
   * "É CELULAR?" É `(max-width: 900px), (max-height: 500px)` — a MESMA
   * pergunta que `.barra-pedido`, o `motion.js` e `.pilares` (mais abaixo)
   * fazem. Toda vez que essa pergunta divergiu entre dois pontos deste
   * arquivo, algo quebrou em silêncio (ver o histórico no `git log` desta
   * seção); manter a consulta idêntica aqui é o que evita repetir isso.
   *
   * A ordem esquerda/direita se mantém porque a ordem no DOM não muda, só o
   * `display` do `<li>` que embrulha cada figura (`.pilar-figura`, ver a
   * regra dele mais acima). `aspect-ratio: 5/6` é a proporção nativa do
   * arquivo — sem cortar nada — e a ALTURA é quem trava (150–260px,
   * clamped), com a largura saindo dela. Foi o pedido explícito, ainda
   * válido aqui: nunca travar a largura e deixar a altura sair da proporção.
   */
  @media (max-width: 900px), (max-height: 500px) {
    /* A SEÇÃO NÃO PRECISA MAIS SER ALTA QUANTO A FOTO — no celular a figura
       vive dentro do trilho, não centralizada como camada. O
       `min-height: var(--gente-caixa)` do desktop viria de uma variável de
       altura de JANELA (até 56rem) e sobraria como espaço vazio enorme abaixo
       do último cartão. */
    .diferenciais {
      min-height: 0;
    }
    /* O padding extra de `--gente-avanco` (3rem) só existe para abrir espaço
       para a foto ancorada nas bordas no desktop. Aqui o trilho é quem carrega
       as figuras nas próprias pontas — sem zerar, o miolo perderia 3rem de
       cada lado à toa numa tela de 390px. */
    .diferenciais > .claro__wrap {
      padding-left: calc(1.5rem + env(safe-area-inset-left));
      padding-right: calc(1.5rem + env(safe-area-inset-right));
    }

    /**
     * SEM CARTÃO PRETO — o pedido foi explícito: "não adicione nenhum
     * background nas imagens". Antes o fundo de estúdio (`#020202`) era o
     * cartão e a `mask-image` o dissolvia; agora não há fundo nenhum, o arquivo
     * é recorte com alpha e o areia da seção passa por trás da pessoa direto.
     *
     * `position: static` tira a figura do posicionamento absoluto do desktop —
     * aqui ela é um ITEM DE FLEX DE VERDADE dentro de `.pilares` (a promoção
     * vem do `display: contents` do `<li>` que a embrulha, ver a regra de
     * `.pilar-figura`). `flex: 0 0 auto` trava o encolhimento: sem isso, o
     * algoritmo de flex tentaria espremer a figura para caber no contêiner —
     * exatamente o que os cartões de pilar já recusam com o próprio
     * `flex: 0 0 min(78%, 20rem)` deles.
     *
     * A LARGURA ERA `var(--pilar-larg)` PURO — A MESMA DO CARTÃO. Até aqui a
     * ALTURA travava (`clamp(150px, 44vw, 260px)`) e a largura saía da
     * proporção 5:6 — em 390px isso dava uma figura de 143x171,6 contra um
     * cartão de 266,8x380,8: pouco mais da metade da largura do cartão, e o
     * dono pediu "do tamanho do card". `var(--pilar-larg)` sem fator (143 →
     * 267px) atendeu o pedido, mas o par de fotos em 760w (o srcset que essa
     * largura seleciona) pesa 167 kB, e isso estourou o teto do gate
     * (`audit-page.mjs`) em 82.419 bytes — não havia orçamento para a
     * largura cheia do cartão. Ver o comentário grande no `<li>` da figura,
     * no markup acima, para a conta completa (por que não há folga em outro
     * lugar da página, por que AVIF não ajuda aqui).
     *
     * `* 0.567` — decisão do dono depois de ver o custo: encolher a figura
     * para caber no orçamento em vez de mexer no vídeo da Cena 2 ou aceitar
     * o estouro. É o MAIOR fator testado que ainda faz o `sizes` do `<img>`
     * selecionar a variante de 420w do `srcset` (e não a de 480w, ~87 kB o
     * par, sempre acima do orçamento de 85,5 kB) em 393px de largura com DPR
     * 2,75 — o viewport que o Pixel 5 emulado do gate usa. Resultado medido:
     * `totalBytes` do gate cai de 1.582.419 para 1.486.539 (teto: 1.500.000,
     * folga de 13.461 bytes). A figura volta a ~150px em 390px de tela —
     * perto do tamanho antigo que motivou o pedido de aumento; o ganho
     * visual quase some, e o dono viu esse número antes de decidir.
     *
     * O GATE NÃO É O PIOR CASO REAL — registrar para quem mexer aqui de
     * novo não descobrir do zero. `audit-page.mjs` mede só em 393px de
     * largura com DPR 2,75 (Pixel 5 emulado). Medido com Playwright em
     * telas reais mais comuns:
     *
     *   390px de largura, DPR 2,75 (o que o gate testaria nesse tamanho)
     *     → seleciona 420w (mesmo bucket aprovado pelo gate)
     *   390px de largura, DPR 3 (iPhone 12/13/14 comuns)
     *     → seleciona 480w — MAIS PESO do que o gate aprovou
     *   414px de largura, DPR 2,75
     *     → seleciona 480w
     *   414px de largura, DPR 3 (iPhone 11/XR/Plus comuns)
     *     → seleciona 620w — ainda mais peso
     *
     * Ou seja: uma fatia real de celulares (DPR 3, comum em iPhone) baixa
     * bucket maior do que o gate mede e aprova, porque o gate só audita um
     * viewport. Isso NÃO foi corrigido agora — é decisão consciente, fora do
     * escopo desta rodada. Para blindar também DPR 3 até 414px de largura
     * (o pior caso comum), o fator precisaria cair para `* 0.4904` — a
     * figura ficaria ainda menor (~140px em 414px de largura) só para cobrir
     * um caso que o gate oficial deste projeto não testa. Não aplicado aqui;
     * o número fica escrito para quando essa lacuna for revisitada.
     *
     * TRAVAR PELA LARGURA, NUNCA PELA ALTURA — testado e descartado: em
     * 360px o cartão mede 405,2px de altura, o que pediria 338px de largura
     * mantendo 5:6, contra 312px de trilho visível. A figura estouraria a
     * janela do trilho sozinha e reabriria o vazamento horizontal que o
     * `overflow-x: auto` do próprio trilho existe para conter por dentro. A
     * largura é segura por construção porque o cartão, do qual ela copia a
     * medida (multiplicada por 0,567), já cabe ali.
     *
     * A ALTURA SAI da proporção 5:6 (a mesma de sempre, nunca cortada) em
     * vez de travar. Resultado: a figura fica mais BAIXA que o cartão em
     * toda largura testada, e o alinhamento pelo pé (`align-self: flex-end`,
     * na regra `.dif__gente--esq, .dif__gente--dir` logo abaixo) é o que
     * decide onde sobra o respiro: em cima, não embaixo, para a figura
     * "pisar" na mesma linha de base do cartão em vez de flutuar no meio da
     * faixa.
     */
    .dif__gente {
      position: static;
      top: auto;
      transform: none;
      flex: 0 0 auto;
      width: calc(var(--pilar-larg) * 0.567);
      height: auto;
      aspect-ratio: 5 / 6;
      background-color: transparent;

      /**
       * ALINHADA PELO PÉ, NÃO PELO MEIO — decisão, não default.
       *
       * `.pilares` não declara `align-items`, então o valor é o inicial,
       * `stretch`. Isso não afeta os cartões (`.pilar`, sem altura própria:
       * eles esticam para a altura do trilho, que a figura de qualquer jeito
       * NÃO alcança mais — mesmo maior, ela segue mais baixa que o cartão em
       * toda largura testada). A figura tem altura própria (via
       * `aspect-ratio`), então `stretch` cai no fallback `flex-start` — topo
       * do trilho — e o respiro sobraria embaixo, com a pessoa flutuando
       * acima da base do cartão.
       *
       * `flex-end` põe o respiro em CIMA: a base da figura encosta na base
       * do trilho (mesma linha da base do cartão, que ocupa a altura
       * inteira), e a foto "pisa" no chão da seção — a mesma leitura que já
       * existe no desktop e que a placa/`.diferenciais` (mais acima) usa
       * como referência.
       */
      align-self: flex-end;
    }
    .dif__gente--esq,
    .dif__gente--dir {
      /* O env() de safe-area do desktop existia para a borda ENCOSTADA na
         física da tela (paisagem com notch). Aqui a figura fica dentro do
         trilho, ladeada por cartões — manter o padding só encolheria a foto
         por dentro sem motivo. O respiro de borda física fica a cargo do
         `padding-inline` do próprio `.claro__wrap` acima. */
      padding-left: 0;
      padding-right: 0;
    }

    /**
     * O RESPIRO — a alternativa ao vídeo, e ela custa ZERO byte.
     *
     * O pedido era animar estas fotos em vídeo. Um clipe de 3s custaria de 120 a
     * 300 kB (o vídeo da Cena 2 gasta 98 kB por segundo) contra uma folga de
     * orçamento de 1,3 kB — e, pior, image-to-video erra exatamente no que está
     * aqui: o xadrez do keffiyeh vira onda e o rosto escorre entre quadros.
     * Rosto de pessoa real da marca derretendo não passa por estilo, passa por
     * defeito.
     *
     * Um `scale` lento de 16s dá o que o vídeo daria: a sensação de que a foto
     * está viva enquanto a pessoa rola.
     *
     * A ANIMAÇÃO USA `scale`, A PROPRIEDADE INDIVIDUAL — não `transform`. O
     * parallax de rolagem já ocupa o `transform` desta mesma imagem, e as duas
     * COMPÕEM: o navegador aplica `scale` antes de `transform`, então o respiro
     * multiplica a escala do parallax em vez de brigar com ela. Usar `transform`
     * nas duas faria a última declaração vencer e o parallax sumiria.
     */
    @media (prefers-reduced-motion: no-preference) {
      /**
       * OS 5% DE PADDING SÃO A FOLGA DO MOVIMENTO, E O ARQUIVO NOVO OS EXIGE.
       *
       * No celular a caixa tem a MESMA proporção do arquivo, então `contain`
       * desenha a foto encostando nas quatro bordas — e o arquivo novo é
       * recorte: o que encosta na borda é o agal, o cotovelo, a beirada do
       * cartaz. Com `overflow: hidden` na figura, qualquer `scale` ou
       * `translate` acima de zero passa a decepar produto, e não mais sobra de
       * fundo como sobrava no par de estúdio.
       *
       * `padding` num elemento substituído encolhe a CAIXA DE CONTEÚDO: com
       * `box-sizing: border-box` herdado da figura, a foto passa a ser desenhada
       * dentro de 90% da caixa e os 5% de cada lado viram a folga em que o
       * respiro (até 1,05) e o parallax (±3%) cabem. É o mesmo mecanismo que no
       * desktop vem do 0,92 de `--gente-larg-desejada`, só que aqui a caixa não
       * pode crescer (ela é metade do par lado a lado) — então quem recua é a
       * foto.
       */
      .dif__gente img {
        padding: 5%;
        animation: dif-gente-respiro 16s ease-in-out infinite alternate;
      }

      /* Onde há scroll-driven animation, o respiro entra como SEGUNDA animação
         e o parallax continua na primeira. `animation-timeline` aceita lista:
         a primeira lê a rolagem, a segunda usa o relógio.

         É `dif-gente-parallax-inteira` — o MESMO do desktop, sem escala. O
         keyframe antigo do celular abria em `scale(1.16)`, herdado de quando a
         imagem entrava por `cover` e tinha 16% de sobra escondida para gastar.
         Sob `contain` não há sobra: 1,16 é a foto 16% maior que a caixa, ou
         seja 8% de cabeça e de placa cortados pelo `overflow` logo na entrada. */
      @supports (animation-timeline: view()) {
        .dif__gente img {
          animation:
            dif-gente-parallax-inteira linear both,
            dif-gente-respiro 16s ease-in-out infinite alternate;
          animation-timeline: view(), auto;
          animation-range: entry 0% exit 100%, normal;
        }
      }
    }
  }

  /**
   * 1,05 e não mais: acima disso o movimento deixa de ser respiro e vira zoom,
   * e a foto passa a chamar atenção para si em vez de para a seção. Em 16s o
   * olho não vê a animação acontecer — vê que a imagem não está morta.
   */
  @keyframes dif-gente-respiro {
    from { scale: 1; }
    to { scale: 1.05; }
  }
  /* O wrap so encosta na borda em tela estreita (abaixo dos 68rem de max-width),
     que e justamente onde ha notch. Os env() valem 0 no resto. */
  .claro__wrap {
    max-width: 68rem;
    margin-inline: auto;
    padding-block: 5rem;
    padding-left: calc(1.5rem + env(safe-area-inset-left));
    padding-right: calc(1.5rem + env(safe-area-inset-right));
  }
  .secao__titulo {
    font-family: var(--font-display);
    font-size: var(--text-titulo);
    text-transform: uppercase;
  }
  .secao__texto { margin-top: 0.75rem; max-width: 38rem; line-height: 1.6; }

  /**
   * OS QUATRO PILARES: QUATRO COLUNAS NO DESKTOP, TRILHO HORIZONTAL NO CELULAR.
   *
   * Era `repeat(auto-fit, minmax(15rem, 1fr))`, e com quatro cartões isso nunca
   * fechava uma linha: medido em 1440x900 dava 3 + 1 órfão, e em celular
   * deitado (844x390) o mesmo 3 + 1. O quarto argumento da casa aparecia
   * sozinho embaixo, parecendo sobra. Com quatro colunas iguais o miolo de
   * 944px dá 218px por cartão — cabe, e a linha fecha.
   *
   * Flex e não grid porque é a MESMA declaração que vira trilho no celular
   * trocando a base do item: nenhum cartão é escondido por breakpoint, todos os
   * quatro continuam no DOM e alcançáveis nas duas larguras. O que muda é se a
   * pessoa lê os quatro de uma vez ou deslizando.
   */
  .pilares {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;

    /* A cascata desta seção: 50px de subida em 400ms, o que o cliente pediu.
       O passo entre cartões vem do `data-reveal="80"` no HTML. */
    --reveal-dist: 50px;
    --reveal-dur: 0.4s;
  }
  .pilares > .pilar {
    flex: 1 1 0;
    /* Item flex tem `min-width: auto`: sem zerar, uma palavra longa do título
       empurra a coluna e desiguala as quatro. */
    min-width: 0;
  }

  /**
   * NO DESKTOP OS QUATRO CARTÕES VIRARAM 2x2, e não foi escolha de estilo — foi
   * a conta da sobreposição.
   *
   * As duas fotos comem 2x486px em 1440 e sobram 428px de texto. Quatro cartões
   * lado a lado ali dão 99px cada: o título de cada pilar quebraria em cinco
   * linhas. Quatro em linha só voltam a caber com 784px de texto, o que
   * limitaria a foto a 308px — de volta ao tamanho da coluna espremida que o
   * dono recusou.
   *
   * `calc(50% - 0.75rem)` (metade menos meia calha) e não `auto-fit` com
   * mínimo: com `auto-fit` existe uma faixa de janelas em que cabem TRÊS por
   * linha, e quatro cartões em três colunas viram 3+1. Duas colunas fixas dão a
   * mesma peça em qualquer largura de desktop.
   *
   * Medido: 1440x900 → 202px por cartão; 1920x1080 → 378px; 1024x768 → 172px.
   * Todos acima dos 178px em que o título parava de quebrar no arranjo antigo,
   * menos o de 1024 — lá o título de dois pilares usa duas linhas, que é o
   * mesmo que já acontecia antes.
   *
   * A consulta é `min-width: 901px` E `min-height: 501px` de propósito: abaixo
   * de qualquer um dos dois os pilares viram trilho horizontal com rolagem
   * (ver o bloco logo abaixo), e ali `flex-wrap` desmontaria o trilho.
   */
  @media (min-width: 901px) and (min-height: 501px) {
    .pilares { flex-wrap: wrap; }
    .pilares > .pilar { flex: 1 1 calc(50% - 0.75rem); }
  }

  /**
   * CELULAR — O PIN HORIZONTAL QUE NÃO É UM PIN.
   *
   * O pedido era travar a seção e passar os cartões na horizontal. A página já
   * gasta seu único pin na Cena 2, e um segundo trilho disputando a rolagem com
   * o primeiro é exatamente o que trava no celular. `scroll-snap` nativo entrega
   * o movimento horizontal com ZERO javascript, sem sequestrar a rolagem
   * vertical e sem competir com nada: quem quiser continuar descendo, desce.
   *
   * A mesma consulta do motion.js e do VideoScene: "é aparelho pequeno?" se
   * pergunta pelo LADO CURTO. Um iPhone deitado tem 844px de largura e passaria
   * por desktop — e é justamente deitado que o 3 + 1 órfão aparecia.
   *
   * `min(78%, 20rem)`: a porcentagem sozinha dava cartão de 620px no celular
   * deitado, largo demais para ser cartão. O teto em rem trava isso e mantém a
   * espiada do próximo, que é a única pista de que existe mais coisa à direita.
   */
  @media (max-width: 900px), (max-height: 500px) {
    .pilares {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      /* A barra nativa é overlay no celular e não aparece; escondê-la evita a
         faixa cinza fixa que os browsers de desktop desenham quando alguém
         estreita a janela. A espiada do cartão seguinte é a pista. */
      scrollbar-width: none;
      /* Sobra para a sombra do foco não ser recortada pelo próprio scroller. */
      padding-block-end: 0.5rem;

      /**
       * `--pilar-larg` É A LARGURA DO CARTÃO, DECLARADA UMA VEZ SÓ.
       *
       * `.dif__gente` (mais acima no arquivo, mesma media query) lê esta
       * mesma variável — multiplicada por 0,567 — para a figura acompanhar
       * a largura do cartão dentro do orçamento de peso (ver o comentário
       * grande em `.dif__gente` para a conta completa: `var(--pilar-larg)`
       * puro, sem fator, foi o pedido original do dono ("do tamanho do
       * card"), mas estourava o gate em 82 kB). Custom property herda pela
       * árvore do DOM, não pela ordem das regras no arquivo: `.pilar-figura`
       * é `display: contents`, então a `<figure>` dentro dele é filha de
       * fato de `.pilares` para efeito de herança, e enxerga esta variável
       * mesmo declarada aqui embaixo.
       *
       * SE ESTE VALOR DIVERGIR do `flex` do `.pilar` logo abaixo, a figura
       * some de ser "do tamanho do card" sem nenhum erro visível — os dois
       * só voltam a bater por acaso. Por isso o `.pilar` consome a MESMA
       * variável em vez de repetir `min(78%, 20rem)` a mão.
       */
      --pilar-larg: min(78%, 20rem);
    }
    .pilares::-webkit-scrollbar {
      display: none;
    }
    .pilares > .pilar {
      flex: 0 0 var(--pilar-larg);
      scroll-snap-align: start;
    }

    /**
     * AS DUAS FIGURAS DE PONTA TAMBÉM PRECISAM DE `scroll-snap-align` — e a
     * ausência foi um defeito medido, não um detalhe.
     *
     * `scroll-snap-type: x mandatory` OBRIGA o repouso a cair num ponto de
     * snap. Sem `scroll-snap-align` na figura, a posição 0 (onde ela mora) não
     * é um ponto válido — só os `.pilar` têm `scroll-snap-align: start` — e o
     * navegador reencaixa sozinho no primeiro CARTÃO assim que a página
     * carrega. Medido: `pilares.scrollLeft` nascia em 167px (a largura da
     * figura + o gap), não em 0, e o rapaz da placa nunca aparecia em repouso
     * — só durante o próprio gesto de arrastar, antes do braço soltar e o
     * snap puxar de volta.
     *
     * `start` na esquerda e `end` na direita: a figura da placa encosta o
     * PRÓPRIO início no início do trilho (repouso = posição 0, a figura cheia
     * e o primeiro cartão parcialmente visível ao lado — a viewport é mais
     * larga que a figura sozinha); a da coca encosta o PRÓPRIO fim no fim do
     * trilho (repouso = scrollLeft máximo, ela cheia e o último cartão do
     * lado esquerdo). Usar `start` nas duas faria o repouso da direita sobrar
     * viewport vazio depois da figura, que não existe pra rolar até lá.
     */
    .dif__gente--esq { scroll-snap-align: start; }
    .dif__gente--dir { scroll-snap-align: end; }
  }

  /* Cartao com regua: o icone ganha area propria e a linha de brasa separa
     simbolo de texto. Sem isso o bloco lia como documento, nao como pagina. */
  .pilar {
    position: relative;
    /* Recorta o número fantasma na borda do cartão. Sem isto ele vaza para o
       areia da seção e, no celular, vira rolagem horizontal do documento. */
    overflow: hidden;
    /* Cria o contexto de empilhamento do cartão: sem isto o `z-index: -1` do
       número o joga para trás do FUNDO do cartão e ele desaparece. */
    isolation: isolate;
    padding: 1.6rem 1.4rem;
    border-radius: 1rem;
    background-color: var(--color-creme);
    border: 1px solid rgb(139 74 43 / 0.14);
  }

  /**
   * O NÚMERO FANTASMA — 01 a 04 em contorno, atrás do conteúdo.
   *
   * Contorno e não preenchimento: preenchido, mesmo a 14%, ele vira um bloco de
   * cor atrás do parágrafo e disputa a leitura. O contorno de 1,5px deixa
   * passar o creme do cartão entre as linhas do texto.
   *
   * Fica no canto inferior direito porque é onde as linhas do parágrafo
   * terminam mais curtas — o corpo do texto passa por cima do vazio do número,
   * não por cima do traço.
   */
  .pilar__numero {
    position: absolute;
    right: 0.75rem;
    bottom: 0.6rem;
    z-index: -1;
    font-family: var(--font-display);
    font-size: 7rem;
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(139 74 43 / 0.16);
    pointer-events: none;
    user-select: none;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pilar__numero {
        animation: dif-numero linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }

  /**
   * "Mais lento que o cartão" tem um sinal, e ele é fácil de inverter.
   *
   * O cartão sobe junto com a rolagem. Para o número parecer mais LENTO ele
   * precisa ficar para trás, ou seja, descer em relação ao cartão enquanto a
   * seção atravessa a tela: de -10% para +10%. O contrário (de +10% para -10%)
   * o faz correr na frente do cartão, que é a leitura oposta.
   *
   * 10% de uma linha de 7rem são ~9,5px, e o número está a 0,6rem da borda —
   * então ele nunca encosta no recorte do cartão. Se ele saísse e voltasse, o
   * pedaço cortado mudaria de tamanho durante a rolagem e leria como defeito.
   */
  @keyframes dif-numero {
    from {
      transform: translate3d(0, -10%, 0);
    }
    to {
      transform: translate3d(0, 10%, 0);
    }
  }
  .pilar__icone {
    display: inline-flex;
    padding-bottom: 0.9rem;
    margin-bottom: 0.9rem;
    color: var(--color-terracota);
    border-bottom: 2px solid var(--color-brasa);
  }
  .pilar__titulo {
    font-family: var(--font-display);
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .pilar__texto { margin-top: 0.5rem; line-height: 1.6; font-size: 0.95rem; opacity: 0.85; }

  /* Foto ocupa a largura do cartao. Antes era miniatura de 8rem num canto e a
     secao lia como lista de delivery — o feedback foi exatamente esse. Com a
     reamostragem para 480px a foto aguenta ser exibida grande. */
  .card {
    display: flex;
    flex-direction: column;
