                sizes="(max-width: 458px) calc((78vw - 37.44px) * 0.567), (max-width: 900px) 181.4px, (max-height: 500px) 181.4px, (max-width: 1088px) 40px, (max-width: 1300px) 130px, (max-width: 1600px) 210px, (max-width: 2100px) 500px, 700px"
                alt={diferenciais.gente.direita.alt}
