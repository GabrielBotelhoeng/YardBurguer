---
import Base from '../layouts/Base.astro';
import ExplodeScene from '../components/ExplodeScene.astro';
import VideoScene from '../components/VideoScene.astro';
import Icone from '../components/Icone.astro';
import Carrossel from '../components/Carrossel.astro';
import { CENA2 } from '../config/cena2.js';
import { existsSync } from 'node:fs';
import copy from '../content/copy.json';
import menu from '../content/menu.json';

/**
 * O hero foi desenhado para foto com Ken Burns, mas ainda nao existe material
 * em alta — o CDN do Brendi so entrega 240x240, pequeno demais para tela cheia.
 * Em vez de deixar markup morto ou uma foto borrada no ponto mais visivel da
 * pagina, a camada de foto so e renderizada quando o arquivo existir no build.
 * Para ativar: colocar a foto em public/assets/hero.webp.
 */
const temFotoHero = existsSync(new URL('../../public/assets/hero.webp', import.meta.url));

const { marca, hero, diferenciais, maisPedidos, ctaFinal, footer } = copy;
const anoAtual = new Date().getFullYear();

/**
 * A copy traz o texto de venda; o menu traz o fato e a foto. O cruzamento
 * acontece por id para que renomear um burger no cardapio nao deixe card orfao
 * silenciosamente — sem foto o card ainda renderiza, so perde a imagem.
 */
const fotoPorId = new Map(
  [...menu.destaques, ...menu.combos].map((item) => [item.id, `/assets/produtos/${item.id}.webp`])
);

const destaques = maisPedidos.itens.map((item) => ({
  ...item,
  foto: fotoPorId.get(item.id) ?? null,
}));

const combos = menu.combos.map((combo) => ({
  ...combo,
  foto: fotoPorId.get(combo.id) ?? null,
}));
---

<Base>
  <!-- Cena 0 — Navbar -->
  <!--
    OS LINKS SAEM DO copy.json, e isso é conserto, não estilo.

    O array `navbar.links` existia desde o primeiro dia e ninguém o lia: os
    links eram escritos à mão aqui, com rótulos que nem estavam na copy. O
    arquivo declarava quatro ("Destaques", "Cardápio", "Combos", "Onde
    estamos") e a tela mostrava três, um deles inexistente na copy ("Nosso
    hambúrguer"). Dado morto divergindo da tela é uma armadilha esperando quem
    for editar a copy achando que edita a página.

    A LISTA FOI RECONCILIADA PARA O QUE ESTÁ NO AR, e não o contrário. Os três
    links de hoje são os que couberam medidos na navbar; entrar com "Cardápio"
    e "Combos" levaria a barra a ~739px de conteúdo numa faixa que começa em
    640px. Quem quiser os dois de volta precisa decidir o que sai — e agora
    esse debate acontece num arquivo só.

    O botão do menu vem ANTES do `<nav>` no DOM porque a ordem de tabulação
    precisa ser botão → painel. Na tela ele é o último item, por `order` na
    media query do celular; no desktop ele não existe.
  -->
  <header class="nav" data-nav>
    <a class="nav__logo" href="/">{marca.nome}</a>
    <button
      class="nav__botao"
      type="button"
      hidden
      aria-expanded="false"
      aria-controls="nav-principal"
      aria-label="Abrir menu"
      data-nav-botao
    >
      <span class="nav__botao-traco" aria-hidden="true"></span>
    </button>
    <nav id="nav-principal" aria-label="Principal" data-nav-lista>
      {copy.navbar.links.map((link) => (
        <a class="nav__link" href={link.ancora}>{link.rotulo}</a>
      ))}
    </nav>
    <a class="cta nav__cta" href={marca.cardapioUrl} data-evento="cardapio-navbar">
      {copy.navbar.ctaPrimario}
    </a>
  </header>

  <main>
    <!-- Cena 1 — Hero -->
    <!--
      `data-esconde-barra`: enquanto esta seção estiver na tela, a barra fixa do
      rodapé fica fora. O CTA do hero já está debaixo do polegar aqui, e uma
      segunda pílula vermelha na mesma dobra só divide o clique em dois.
    -->
    <section class="hero textura-brasa" aria-labelledby="hero-titulo" data-esconde-barra>
      {
        temFotoHero && (
          <img
            class="hero__foto"
            src="/assets/hero.webp"
            alt=""
            aria-hidden="true"
            width="1376"
            height="768"
            fetchpriority="high"
            data-ken-burns
          />
        )
      }
      <div class="hero__conteudo" data-parallax-rapido>
        <p class="hero__sobretitulo">{hero.sobretitulo}</p>
        <h1 id="hero-titulo" class="hero__titulo">
          {hero.titulo}<br /><span class="hero__destaque">{hero.tituloDestaque}</span>
        </h1>
        <p class="hero__subtitulo">{hero.subtitulo}</p>
        <a class="cta" href={marca.cardapioUrl} data-evento="cardapio-hero">{hero.cta}</a>
      </div>
    </section>

    {/*
      Cena 2 — a montagem do burger, em uma das duas variantes.

      Uma OU outra, nunca as duas: o orçamento de movimento permite no máximo um
      pin por página. Ver src/config/cena2.js para trocar (CENA2=camadas).
    */}
    {CENA2 === 'video' ? <VideoScene /> : <ExplodeScene />}

    <!-- Cena 3 — Diferenciais -->
    <!--
      Diferenciais.

      Duas coisas saíram daqui depois do feedback:

      1. Os emojis. Renderizam diferente em cada sistema e leem como atalho
         barato — o oposto da credibilidade que a página precisa passar.
      2. A palavra "DO SERTÃO" gigante ao fundo. Ela ficava ATRÁS do texto do
         corpo e o resultado era uma marca d'água ilegível cruzando o
         parágrafo. Palavra de fundo funciona na cena 2, onde há espaço vazio
         para ela ocupar; aqui só sujava a leitura.

      O layout deixou de ser lista corrida e virou grade de cartões, com o
      ícone no topo e uma régua de brasa separando ícone de título.
    -->
    <!--
      AS DUAS PESSOAS LADEIAM A SEÇÃO — e o fundo preto delas é decisão, não sobra.

      Recortar era impossível: a foto da placa tem manto PRETO sobre fundo preto,
      e qualquer recorte por luminância comeria o manto e o bordado dourado (a do
      thobe branco recortaria bem, mas metade recortada e metade não vira
      colagem). O preto do estúdio é o mesmo carvão da marca, então ele entra
      como moldura: duas faixas escuras encostando o areia numa borda vertical
      limpa, e a seção lê como cartaz.

      A ORDEM NO DOM É ESQUERDA → CONTEÚDO → DIREITA, e não é arrumação: no
      celular as figuras caem para a linha de baixo por grid-template-areas, e
      quem estava à esquerda continua à esquerda. Fosse ordem visual por CSS, o
      leitor de tela ouviria as duas antes do título.
    -->
    <section class="claro diferenciais" aria-labelledby="dif-titulo">
      <figure class="dif__gente dif__gente--esq">
        <img
          src={`/assets/pessoas/${diferenciais.gente.esquerda.arquivo}-840.webp`}
          srcset={`/assets/pessoas/${diferenciais.gente.esquerda.arquivo}-420.webp 420w, /assets/pessoas/${diferenciais.gente.esquerda.arquivo}-620.webp 620w, /assets/pessoas/${diferenciais.gente.esquerda.arquivo}-840.webp 840w`}
          sizes="(max-width: 900px) 50vw, 30vw"
          alt={diferenciais.gente.esquerda.alt}
          width="840"
          height="1260"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="claro__wrap">
        <h2 id="dif-titulo" class="secao__titulo">{diferenciais.titulo}</h2>
        <p class="secao__texto">{diferenciais.texto}</p>
        {/*
          `data-reveal="80"` — o passo da cascata vem do HTML.

          O motion.js usava 90ms fixo para todo grupo. Aqui o cliente pediu
          0,08s, e o número não vale uma segunda função no script: vira valor do
          atributo que já existia. Sem valor, continua 90ms como antes.

          `data-trilho` é o que o motion.js procura para decidir se esta lista
          vira parada de teclado — ver initTrilhoPilares.
        */}
        <ul
          class="pilares"
          role="list"
          aria-label={diferenciais.titulo}
          data-reveal="80"
          data-trilho
        >
          {
            diferenciais.pilares.map((pilar, i) => (
              <li class="pilar">
                {/*
                  O número fantasma é DECORAÇÃO e sai do fluxo de leitura.

                  aria-hidden porque "01" lido em voz alta antes do título não
                  informa nada — a ordem já é a da lista. Fica no DOM e não no
                  ::before por um motivo só: pseudo-elemento não aceita
                  animation-timeline em Safari, e é ele que faz o parallax.
                */}
                <span class="pilar__numero" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="pilar__icone">
                  <Icone nome={pilar.icone as any} />
                </span>
                <h3 class="pilar__titulo">{pilar.titulo}</h3>
                <p class="pilar__texto">{pilar.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="dif__gente dif__gente--dir">
        <img
          src={`/assets/pessoas/${diferenciais.gente.direita.arquivo}-840.webp`}
          srcset={`/assets/pessoas/${diferenciais.gente.direita.arquivo}-420.webp 420w, /assets/pessoas/${diferenciais.gente.direita.arquivo}-620.webp 620w, /assets/pessoas/${diferenciais.gente.direita.arquivo}-840.webp 840w`}
          sizes="(max-width: 900px) 50vw, 30vw"
          alt={diferenciais.gente.direita.alt}
          width="840"
          height="1260"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    {/*
      Cena 4 — Os mais pedidos, agora em carrossel coverflow.

      A grade de três cartões virou pilha 3D a pedido do cliente. Ver o cabeçalho
      de Carrossel.astro para o que foi corrigido em relação à referência React
      que veio junto com o pedido.

      A <section> fica AQUI e não dentro do componente: o `<style>` do Astro é
      escopado, e `.claro` / `.secao__titulo` / `.secao__texto` moram nesta
      folha. Levar a section para o componente lhe custava o fundo areia — o
      texto virava branco sobre escuro, medido na primeira tentativa.
    */}
    <section class="claro" id="mais-pedidos" aria-labelledby="mp-titulo">
      <div class="claro__wrap">
        <h2 id="mp-titulo" class="secao__titulo">{maisPedidos.titulo}</h2>
        <p class="secao__texto">{maisPedidos.texto}</p>
        <Carrossel />
      </div>
    </section>

    <!-- Cena 5 — Cardápio completo (vitrine; o pedido acontece no Brendi) -->
    <section class="cardapio" id="cardapio" aria-labelledby="cardapio-titulo">
      <div class="claro__wrap">
        <h2 id="cardapio-titulo" class="secao__titulo">{copy.cardapio.titulo}</h2>
        <p class="secao__texto">{copy.cardapio.texto}</p>
        <a class="cta cardapio__cta" href={marca.cardapioUrl} data-evento="cardapio-secao">
          {copy.cardapio.cta}
        </a>
        <p class="cardapio__nota">{copy.cardapio.nota}</p>
      </div>
    </section>

    <!-- Cena 6 — Combos -->
    <section class="combos" aria-labelledby="combos-titulo">
      <div class="claro__wrap">
        <h2 id="combos-titulo" class="secao__titulo">{copy.combos.titulo}</h2>
        <p class="secao__texto">{copy.combos.texto}</p>

        <ul class="combos__lista" role="list" data-reveal>
          {
            combos.map((combo) => (
              <li class="combo">
                {combo.foto && (
                  <img
                    class="combo__foto"
                    src={combo.foto}
                    alt={`${combo.nome}: ${combo.composicao}`}
                    width="240"
                    height="240"
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <div>
                  <h3 class="combo__nome">{combo.nome}</h3>
                  <p class="combo__composicao">{combo.composicao}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <a class="cta combos__cta" href={marca.cardapioUrl} data-evento="cardapio-combos">
          {copy.combos.cta}
        </a>
      </div>
    </section>

    <!--
      Onde estamos — a seção que faltava.

      A navbar prometia "Onde estamos" no copy.json desde o início e a seção
      nunca existiu. Mais grave: não havia um único link de WhatsApp na página,
      enquanto as duas referências brasileiras do briefing põem em destaque. O
      cardápio no Brendi era o único caminho de conversão; quem tinha dúvida
      antes de pedir não tinha para onde ir.
    -->
    <section class="onde" id="onde-estamos" aria-labelledby="onde-titulo">
      <div class="claro__wrap">
        <h2 id="onde-titulo" class="secao__titulo">{copy.ondeEstamos.titulo}</h2>
        <p class="secao__texto">{copy.ondeEstamos.texto}</p>

        <!--
          Tudo na mesma grade, com o mesmo tratamento de rotulo.

          Antes o endereco ficava solto acima, repetindo "Setor Morada do Sol,
          Rio Verde" que ja estava na linha de cima, e horario e pagamento
          vinham como blocos avulsos. Tres niveis de informacao com tres
          formatos diferentes e o que fazia a secao parecer bagunca.

          O pagamento tambem deixou de ser uma frase corrida e virou lista: ler
          "PIX, Cartao de credito online · Dinheiro, Credito, Debito, Vale-
          refeicao, Vale-alimentacao na entrega" numa linha so nao e leitura, e
          decifracao.
        -->
        <dl class="onde__dados">
          <div class="onde__dado">
            <dt>{copy.ondeEstamos.tituloEndereco}</dt>
            <dd>
              <address class="onde__endereco" data-endereco-texto>
                {marca.rua}<br />{marca.bairro}<br />{marca.cidade} – {marca.estado}, {marca.cep}
              </address>
              {/*
                O BOTÃO NASCE ESCONDIDO, IGUAL AO SELO ACIMA.

                Copiar é operação de JS: sem ele o botão ficaria na tela
                prometendo o que não faz. O que sobra sem script é o endereço
                escrito, que continua correto e continua selecionável.

                O texto de sucesso e o de falha viajam em data-atributo em vez
                de estarem no módulo: assim a copy continua morando no
                copy.json e o script não arrasta a copy inteira para o bundle.

                aria-live=polite no aviso, e ele já está no DOM desde o
                primeiro quadro justamente para poder anunciar depois.
              */}
              <p class="onde__copiar-linha">
                <button
                  type="button"
                  class="onde__copiar"
                  data-copiar-endereco
                  data-endereco={marca.enderecoCompleto}
                  data-ok-texto={copy.ondeEstamos.copiarOk}
                  data-falha-texto={copy.ondeEstamos.copiarFalhou}
                  hidden
                >
                  <svg
                    class="onde__copiar-icone"
                    viewBox="0 0 24 24"
                    width="17"
                    height="17"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      d="M9 3h8a2 2 0 0 1 2 2v10h-2V5H9V3Zm-4 4h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Zm0 2v10h8V9H5Z"
                    />
                  </svg>
                  {copy.ondeEstamos.ctaCopiar}
                </button>
                <span class="onde__copiado" data-copiar-aviso aria-live="polite"></span>
              </p>
            </dd>
          </div>
          <div class="onde__dado">
            <dt>{copy.ondeEstamos.tituloHorario}</dt>
            <dd>
              {marca.horario.texto}
              {/*
                O SELO NASCE VAZIO E SÓ O CLIENTE O PREENCHE.

                Não dá para renderizar isto no build: a página é estática e
                ficaria congelada dizendo "aberto agora" às três da manhã. Sem
                JS ele permanece vazio e o que se lê é o horário fixo acima,
                que continua correto — degradar para menos informação é certo,
                para informação errada não.

                aria-live=polite: quem usa leitor de tela ouve o estado quando
                ele chega, sem ter o foco roubado.
              */}
              <span class="onde__estado" data-estado hidden aria-live="polite"></span>
            </dd>
          </div>
          <div class="onde__dado">
            <dt>{copy.ondeEstamos.tituloPagamento}</dt>
            <dd>
              <span class="onde__pgto">Online</span> {marca.pagamento.online.join(' · ')}
              <br />
              <span class="onde__pgto">Na entrega</span> {marca.pagamento.naEntrega.join(' · ')}
            </dd>
          </div>
        </dl>

        <div class="onde__acoes" data-reveal>
          <a
            class="cta cta--whats"
            href={marca.whatsappUrl}
            target="_blank"
            rel="noopener"
            data-evento="whatsapp-onde"
          >
            {copy.ondeEstamos.ctaWhats}
          </a>
          {/*
            NÃO HÁ MAPA AQUI, E É DECISÃO — não esquecimento.

            Um iframe do Google Maps custa centenas de kB e traz JS de terceiro
            numa página que está a 167 kB do teto e não tem banner de consentimento.
            A Static Maps API exige chave paga, que este projeto não tem. Desenhar
            um mapa nosso sem material seria pior que tudo: mapa errado manda o
            cliente para a rua errada, e aí o link honesto vira prejuízo.

            O que dá para melhorar de graça é o próprio link: alvo grande com
            borda, pino, a rua escrita nele e o aviso de que abre outra aba. Ele
            deixa de ser uma palavra sublinhada perdida ao lado de um botão
            vermelho e passa a parecer o que é — o caminho até a porta.
          */}
          <a class="onde__link" href={marca.mapaUrl} target="_blank" rel="noopener">
            <svg
              class="onde__link-pino"
              viewBox="0 0 24 24"
              width="22"
              height="22"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M12 2a7 7 0 0 0-7 7c0 5.05 6.13 12.3 6.39 12.61a.8.8 0 0 0 1.22 0C12.87 21.3 19 14.05 19 9a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5Z"
              />
            </svg>
            <span class="onde__link-texto">
              <span class="onde__link-titulo">{copy.ondeEstamos.ctaMapa}</span>
              <span class="onde__link-apoio">
                {marca.rua} · {copy.ondeEstamos.mapaApoio}
              </span>
            </span>
          </a>
        </div>

        <p class="onde__nota">{copy.ondeEstamos.notaWhats}</p>
      </div>
    </section>

    <!-- Cena 7 — CTA final -->
    <!--
      O mesmo motivo do hero, invertido no tempo: aqui a página inteira já foi
      lida e o CTA final ocupa o centro da tela. Deixar a barra por cima dele
      seria pôr dois botões idênticos na mesma dobra e ainda cobrir o rodapé.
    -->
    <section class="final textura-brasa" aria-labelledby="final-titulo" data-esconde-barra>
      <h2 id="final-titulo" class="final__titulo">
        {ctaFinal.titulo} <span class="final__destaque">{ctaFinal.tituloDestaque}</span>
        {ctaFinal.tituloFim}
      </h2>
      <p class="final__texto">{ctaFinal.texto}</p>
      <a class="cta" href={marca.cardapioUrl} data-evento="cardapio-final">{ctaFinal.cta}</a>
      <p class="final__apoio">{ctaFinal.apoio}</p>
    </section>
  </main>

  <!--
    BARRA FIXA DE PEDIDO — só no celular, e só depois que o hero sai da tela.

    O pedido acontece no Brendi, e a página inteira existe para entregar esse
    clique. Entre o hero e o CTA final há cinco seções em que a única porta era
    a pílula pequena do canto da navbar — no celular, no topo, longe do polegar.
    Esta barra é a mesma porta, sempre à mão.

    FICA FORA DO <main> de propósito: é chrome da página, não conteúdo dela.
    Antes do <footer> na ordem do DOM porque quem navega por Tab deve encontrar
    o botão de pedir antes dos links de rodapé, não depois.

    Sem JavaScript ela nunca aparece — nenhum `data-visivel` é escrito e o
    estado de repouso é fora da tela. É a degradação certa: o CTA do hero, o da
    navbar, o da seção de cardápio, o dos combos e o final continuam todos lá.
  -->
  <div class="barra-pedido" data-barra-pedido>
    <a class="cta barra-pedido__cta" href={marca.cardapioUrl} data-evento="cardapio-barra">
      {copy.barraPedido.cta}
    </a>
  </div>

  <!-- Cena 8 — Footer -->
  <footer class="rodape">
    <p class="rodape__marca">{marca.nome}</p>
    <p class="rodape__tagline">{footer.tagline}</p>
    <p>
      <a class="rodape__link" href={marca.instagramUrl}>{marca.instagram}</a>
      ·
      <a class="rodape__link" href={marca.cardapioUrl}>Cardápio</a>
    </p>
    <p class="rodape__direitos">© {anoAtual} {footer.direitos}</p>
  </footer>

  <script>
    import '../scripts/motion.js';
  </script>

  {/*
    O menu do celular. Bloco próprio, sem dependência de ordem: o módulo lê o
    header, troca atributos e volta. Se ele não rodar, os links continuam na
    tela — o CSS de painel está todo atrás de `data-menu`, que só ele escreve.
  */}
  <script>
    import { initNavMenu } from '../scripts/nav-menu.mjs';
    import { initNavSecaoAtiva } from '../scripts/nav-secao-ativa.mjs';
    initNavMenu();
    initNavSecaoAtiva();
  </script>

  <script>
    import { initCarrossel } from '../scripts/carrossel.js';
    initCarrossel();
  </script>

  {/*
    O selo de aberto/fechado recebe horário e textos daqui em vez de importar o
    copy.json: assim o módulo não arrasta a copy inteira para o bundle do
    cliente, e continua sendo testável passando um horário na mão.
  */}
  <script is:inline define:vars={{ horario: marca.horario, textos: copy.ondeEstamos.estado }}>
    window.__yardLoja = { horario, textos };
  </script>
  {/*
    Os dois módulos da seção "Onde a gente fica" dividem o mesmo <script>: cada
    bloco vira um chunk próprio no build, e uma requisição a menos no 4G do
    interior vale mais que a separação cosmética.
  */}
  <script>
    import { initEstadoLoja } from '../scripts/estado-loja.mjs';
    import { initCopiarEndereco } from '../scripts/copiar-endereco.mjs';
    initEstadoLoja(window.__yardLoja);
    initCopiarEndereco();
  </script>
</Base>

<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /**
     * A navbar e o container que mais encosta em borda: fixa, no topo, indo de
     * ponta a ponta. Com viewport-fit=cover ela passa por baixo do notch e do
     * indicador de home se nao pagar o recorte.
     *
     * Os env() sao somados ao padding que ja existia, nunca o substituem — onde
     * nao ha recorte valem 0 e o resultado e exatamente 1rem/1.5rem de sempre.
     * Esquerda e direita separadas porque em paisagem o notch fica so de um
     * lado, e um padding simetrico desperdicaria o lado limpo.
     */
    padding-block: calc(1rem + env(safe-area-inset-top)) 1rem;
    padding-left: calc(1.5rem + env(safe-area-inset-left));
    padding-right: calc(1.5rem + env(safe-area-inset-right));
    transition: background-color 0.3s ease;
  }
  .nav[data-scrolled] {
    background-color: var(--color-carvao);
  }
  .nav__logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-creme);
    text-decoration: none;
    letter-spacing: 0.05em;
  }
  /**
   * O ALVO DE TOQUE TEM 44px, e o texto continua com 19px de altura.
   *
   * Estes três links eram os únicos alvos da página abaixo do mínimo de 44px —
   * `.rodape__link` e `.onde__link` já pagavam `min-height`, e ninguém tinha
   * voltado aqui. O gate mobile reprovava os três a cada rodada (Destaques
   * 77x19, Nosso hambúrguer 138x19, Onde estamos 104x19).
   *
   * `inline-flex` + `align-items: center` é o que cresce a ÁREA sem crescer a
   * linha: o texto fica do mesmo tamanho e do mesmo lugar, e o dedo ganha os
   * 44px. Padding vertical sozinho empurraria a navbar inteira para baixo.
   *
   * Os links só aparecem acima de 640px (a regra logo abaixo os remove no
   * celular), mas a navbar em PAISAGEM cabe nessa faixa — e paisagem é
   * exatamente onde o gate media a reprovação.
   */
  .nav__link {
    color: var(--color-areia);
    text-decoration: none;
    margin-inline: 0.75rem;
    font-size: 0.95rem;

    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .nav__link:hover { color: var(--color-brasa); }

  /**
   * A SEÇÃO QUE ESTÁ SENDO LIDA — marcada por `aria-current`, não por classe.
   *
   * O atributo é o que o leitor de tela anuncia como item atual; a cor e a
   * régua são a versão visual da mesma informação, e não uma segunda fonte de
   * verdade. Quem escreve o atributo é nav-secao-ativa.mjs.
   *
   * A régua é `box-shadow` e não `border-bottom`: borda mudaria a altura da
   * caixa do link, e a caixa aqui é o alvo de toque de 44px que já foi medido e
   * ajustado uma vez. Sombra pinta sem empurrar nada.
   */
  .nav__link[aria-current='true'] {
    color: var(--color-brasa);
    box-shadow: inset 0 -2px 0 0 var(--color-brasa);
  }

  /**
   * O BOTÃO DO MENU — três traços feitos de um elemento só.
   *
   * O `<span>` é o traço do meio; `::before` e `::after` são os de cima e de
   * baixo, deslocados 7px. Um elemento em vez de três porque a animação de
   * virar "X" precisa girar dois traços em torno do MESMO centro, e três
   * irmãos num flex não compartilham centro sem posicionamento absoluto de
   * qualquer jeito.
   *
   * Fora do celular ele não é escondido por `hidden` no HTML e sim por
   * `display: none` aqui: o atributo é o estado inicial, antes do JS, e some
   * assim que o script revela o botão. Quem manda no desktop é a media query.
   */
  .nav__botao {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-creme);
    cursor: pointer;
  }
  .nav__botao-traco,
  .nav__botao-traco::before,
  .nav__botao-traco::after {
    position: absolute;
    left: 50%;
    width: 22px;
    height: 2px;
    margin-left: -11px;
    background-color: currentColor;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .nav__botao-traco { top: 50%; margin-top: -1px; }
  .nav__botao-traco::before,
  .nav__botao-traco::after {
    content: '';
    left: 0;
    margin-left: 0;
  }
  .nav__botao-traco::before { top: -7px; }
  .nav__botao-traco::after { top: 7px; }

  /**
   * Aberto: o traço do meio some e os outros dois viram X sobre o centro.
   *
   * O traço do meio some por `background-color: transparent`, NÃO por
   * `opacity: 0`. Os outros dois traços são `::before` e `::after` DELE — são
   * filhos — e opacity no pai multiplica a dos filhos: o `opacity: 1` que
   * estava escrito neles não resgatava nada e o botão inteiro desaparecia no
   * exato momento em que vira o botão de fechar. Pego em print, não em código.
   */
  .nav[data-menu-aberto] .nav__botao-traco { background-color: transparent; }
  .nav[data-menu-aberto] .nav__botao-traco::before { transform: translateY(7px) rotate(45deg); }
  .nav[data-menu-aberto] .nav__botao-traco::after { transform: translateY(-7px) rotate(-45deg); }

  @media (prefers-reduced-motion: reduce) {
    .nav__botao-traco,
    .nav__botao-traco::before,
    .nav__botao-traco::after { transition: none; }
  }

  /**
   * Abaixo de 640px a navegação vira menu — e NÃO some.
   *
   * Aqui existia `.nav nav { display: none }`. O motivo escrito era real: em
   * 390px os três links empilhavam por cima do CTA e o logo quebrava em duas
   * linhas. Mas a página é vista principalmente no celular, e a conclusão de
   * "os links são atalho, não navegação essencial" escondia da maioria a única
   * forma de pular para o cardápio, para a Cena 2 ou para o endereço sem rolar
   * a página inteira com o polegar.
   *
   * SÃO DOIS ESTADOS, e o segundo depende do JS:
   *
   *   1. `.nav` sozinha — os links caem numa segunda linha por `flex-wrap`.
   *      É o layout feio que motivou o `display: none`, e é de propósito: sem
   *      JavaScript, feio e alcançável ganha de bonito e ausente.
   *   2. `.nav[data-menu]` — o atributo que só nav-menu.mjs escreve. Os links
   *      saem do fluxo, viram painel abaixo da barra, e o botão aparece. A
   *      navbar volta a ter uma linha só.
   *
   * O FUNDO SÓLIDO É FORÇADO COM O PAINEL ABERTO. A navbar só ganha cor com
   * `data-scrolled`, e no topo da página ela é transparente — um painel opaco
   * pendurado numa barra transparente deixaria os links do menu flutuando
   * sobre o hero sem nada os prendendo à barra.
   */
  @media (max-width: 639px) {
    .nav {
      flex-wrap: wrap;
      padding-left: calc(1rem + env(safe-area-inset-left));
      padding-right: calc(1rem + env(safe-area-inset-right));
    }
    .nav__logo { font-size: 1.05rem; white-space: nowrap; }
    .nav__cta { padding-inline: 1.1rem; font-size: 0.9rem; order: 2; }
    .nav__botao:not([hidden]) { display: block; order: 3; margin-left: 0.25rem; }

    /* Estado 1 — sem JS: segunda linha, largura inteira, sem sobrepor nada. */
    .nav nav {
      order: 4;
      flex-basis: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: 0 0.5rem;
    }
    .nav nav .nav__link { margin-inline: 0; }

    /* Estado 2 — com JS: painel. */
    .nav[data-menu] nav {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: none;
      flex-direction: column;
      gap: 0;
      box-sizing: border-box;
      padding: 0.25rem calc(1rem + env(safe-area-inset-left)) 0.75rem
        calc(1rem + env(safe-area-inset-right));
      background-color: var(--color-carvao);
      box-shadow: 0 12px 24px rgb(0 0 0 / 0.35);
    }
    .nav[data-menu][data-menu-aberto] nav { display: flex; }
    .nav[data-menu-aberto] { background-color: var(--color-carvao); }

    /**
     * 48px e não 44px: o painel é uma pilha de alvos vizinhos, e alvo colado em
     * alvo erra mais que alvo isolado. A régua de brasa entre um e outro é a
     * mesma linguagem das seções, e dá ao dedo uma fronteira visível.
     */
    .nav[data-menu] .nav__link {
      min-height: 48px;
      font-size: 1rem;
      border-bottom: 1px solid rgb(255 255 255 / 0.08);
    }
    .nav[data-menu] .nav__link:last-child { border-bottom: 0; }

    /**
     * No painel a régua vira barra à esquerda. Sublinhado num item de lista
     * empilhada se confunde com o separador do item de cima — e aqui já existe
     * um separador em cada linha.
     */
    .nav[data-menu] .nav__link[aria-current='true'] {
      box-shadow: inset 3px 0 0 0 var(--color-brasa);
      padding-left: 0.75rem;
    }
  }

  /**
   * BARRA FIXA DE PEDIDO — a porta do Brendi debaixo do polegar.
   *
   * "É CELULAR?" É A MESMA PERGUNTA QUE motion.js FAZ, letra por letra:
   * `(max-width: 900px), (max-height: 500px)`. Largura sozinha não responde —
   * um iPhone 13 deitado tem 844px de largura e passaria por desktop. O lado
   * curto de um aparelho não muda quando ele gira, e é essa a segunda condição.
   * Toda vez que essas duas perguntas divergiram neste projeto, alguma coisa
   * quebrou em silêncio.
   *
   * A PERGUNTA É FEITA NO CSS, e não no JavaScript, de propósito. O `ehMobile`
   * do motion.js é resolvido uma vez na carga: quem gira o aparelho depois fica
   * com a resposta velha. A media query reavalia sozinha na rotação. Ao script
   * sobra a única pergunta que independe de orientação — "o hero já saiu?".
   *
   * DEITADO ELA CONTINUA APARECENDO, e isso é escolha, não descuido: o público
   * desta landing é celular, e sumir com a porta principal porque o aparelho
   * girou seria esconder da maioria. O que muda é o respiro — em 390px de tela
   * útil cada pixel do rodapé é caro, então o padding encolhe e o que fica de
   * pé é o alvo de 48px.
   *
   * Fundo sólido em vez de backdrop-filter: por cima da barra passa desde o
   * areia dos destaques até o take em vídeo da Cena 2, e desfoque em tempo real
   * sobre vídeo é exatamente o custo de GPU que esta página não paga.
   */
  .barra-pedido {
    display: none;
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 90; /* abaixo da navbar (100): as duas nunca se encostam, mas a
                    ordem tem que ser deliberada e não sorteada pelo DOM. */

    /* Este projeto não tem reset global de box-sizing — o padding de safe-area
       abaixo somaria à largura de 100% e viraria overflow horizontal. Mesmo
       motivo já documentado em .dif__gente. */
    box-sizing: border-box;

    /**
     * SAFE AREA NO PADDING, não na margem.
     *
     * Com viewport-fit=cover (ver Base.astro) a área útil vai até a borda
     * física. No iPhone com barra de gestos, um rodapé fixo sem este env()
     * nasce POR BAIXO dela: o botão aparece inteiro e o toque não chega —
     * defeito que não se vê em print nenhum.
     *
     * O fundo continua encostando na borda de baixo (é o env() no padding que
     * garante isso), então não sobra faixa clara entre a barra e o aparelho.
     */
    padding-block: 0.6rem calc(0.6rem + env(safe-area-inset-bottom));
    padding-left: calc(1rem + env(safe-area-inset-left));
    padding-right: calc(1rem + env(safe-area-inset-right));

    background-color: var(--color-carvao);
    border-top: 1px solid rgb(232 220 200 / 0.12);

    /**
     * ESCONDIDA É `display: none`, e isso foi MEDIDO antes de ser escolhido.
     *
     * A primeira versão usava `visibility: hidden`, que já resolve Tab e leitor
     * de tela. Mas `visibility` mantém a caixa no layout, e o `audit-page.mjs`
     * filtra elemento oculto por `offsetParent !== null` — que ignora
     * `visibility`. Resultado medido: `semJs.ctasVisiveis` subiu de 6 para 7,
     * contando um botão que ninguém vê. Cegar o instrumento para caber a
     * feature é pior do que não ter a feature; a barra some de verdade.
     *
     * O estado de chegada continua sendo só `translateY(0)`: ele existe
     * estático, sem depender de animação nenhuma. Sob `prefers-reduced-motion`
     * a regra global de tokens.css zera a duração e a barra simplesmente
     * APARECE — sem deslizar, mas nunca ausente.
     *
     * `allow-discrete` + `@starting-style` são o que deixa `display` participar
     * da transição: sem eles o navegador troca `none`/`block` de uma vez e o
     * transform não teria de onde partir. Onde não houver suporte, a declaração
     * de `transition` é descartada inteira e a barra aparece de estalo — que é
     * exatamente o mesmo estado final, só sem o deslize.
     *
     * `transform` e nada mais: a barra é `fixed`, não ocupa espaço no fluxo e
     * não desloca um pixel de layout ao entrar. O gate deste projeto mede
     * EMPURRÃO, e o empurrão aqui é zero por construção — verificado em 0px.
     */
    transform: translateY(100%);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      display 0.28s allow-discrete;
  }
  /* Largura inteira: num rodapé de celular o alvo certo é a faixa toda, não uma
     pílula centrada que obriga a mirar. 48px e não os 44px do mínimo — 44 é o
     piso de auditoria, e este é o botão mais importante da página. */
  .barra-pedido__cta {
    width: 100%;
    min-height: 48px;
    font-size: 1.05rem;
  }

  /**
   * O `display: block` mora DENTRO da media query, e é só ele que faz a barra
   * existir. No desktop o script continua escrevendo `data-visivel` — deixá-lo
   * cego para a orientação é o que mantém a rotação correta — e a media query
   * simplesmente não lhe dá corpo.
   */
  @media (max-width: 900px), (max-height: 500px) {
    .barra-pedido[data-visivel] {
      display: block;
      transform: translateY(0);
    }
    @starting-style {
      .barra-pedido[data-visivel] { transform: translateY(100%); }
    }
  }

  /* Em paisagem o rodapé disputa 390px de altura com a página inteira. */
  @media (max-height: 500px) {
    .barra-pedido { padding-block: 0.35rem calc(0.35rem + env(safe-area-inset-bottom)); }
  }

  .hero {
    position: relative;
    min-height: var(--cena-altura);
    display: grid;
    place-content: center;
    text-align: center;
    padding: 7rem 1.5rem 4rem;
    background-color: var(--color-carvao);
    overflow: hidden;
  }
  .hero__conteudo {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.25rem;
    justify-items: center;
  }
  /* Overlay carvão por cima da foto: o texto precisa vencer o contraste
     independente de como a foto for iluminada. */
  .hero__foto {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
    will-change: transform;
  }
  .hero__sobretitulo {
    color: var(--color-brasa);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    font-size: 0.8rem;
  }
  .hero__titulo {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .hero__destaque { color: var(--color-brasa); }
  .hero__subtitulo {
    max-width: 34rem;
    margin-inline: auto;
    color: var(--color-areia);
    line-height: 1.6;
  }

  .claro { background-color: var(--color-areia); color: var(--color-carvao); }

  /**
   * A SEÇÃO DOS DIFERENCIAIS É UM CARTAZ DE TRÊS COLUNAS.
   *
   * As laterais são as duas pessoas; o miolo é o conteúdo. O `1fr` das pontas
   * come toda a sobra da tela, então as figuras SANGRAM até a borda — é o que
   * separa "cartaz" de "duas fotinhas com margem".
   *
   * `minmax(0, 68rem)` no meio e não `68rem`: sem o minmax o miolo se recusa a
   * encolher abaixo do conteúdo e empurra as figuras para fora em telas médias.
   *
   * O `align-items` padrão do grid (stretch) é o que faz as duas colunas escuras
   * terem exatamente a altura da seção. Não travar altura em px aqui: a seção
   * cresce com a copy, e um número fixo descolaria no dia em que entrar um
   * quinto pilar.
   */
  .diferenciais {
    position: relative;
    display: grid;
    /* 62rem e não os 68rem das outras seções: cada rem que sai do miolo entra
       nas duas laterais, e é largura de lateral que decide se a placa da foto
       da direita é legível. Medido em 1440: 68rem deixa 176px por lado (30% da
       foto, a placa vira "VEM" e um Y); 62rem deixa 224px. Os cartões não
       sentem — a grade já quebrava em 3+1 nas duas larguras. */
    /**
     * A LATERAL TEM PISO; QUEM CEDE É O MIOLO.
     *
     * Com `minmax(0, 1fr)` nas pontas, a coluna da foto era só o que sobrava
     * depois dos 62rem do miolo — e entre 901px e ~1270px de viewport não
     * sobrava quase nada. Medido: 992px de tela dá 0px de foto, 1024 dá 16px,
     * 1100 dá 54px. A imagem continua sendo baixada inteira e entregue como um
     * filete de carvão: paga-se o peso e não se vê a pessoa.
     *
     * `minmax(9rem, 1fr)` inverte quem cede. A lateral nunca desce de 144px, o
     * miolo encolhe dos 62rem só quando precisa, e a seção nunca mais tem uma
     * coluna que existe no layout e não existe no olho. Abaixo de 900px isto
     * não vale: lá a grade já vira duas colunas e as figuras fecham a seção
     * lado a lado, com largura de verdade.
     */
    grid-template-columns: minmax(9rem, 1fr) minmax(0, 62rem) minmax(9rem, 1fr);
    grid-template-areas: 'esq miolo dir';
  }
  /**
   * `margin-inline: 0` ANULA O `auto` DO `.claro__wrap`, E ISSO É O QUE IMPEDE
   * A SEÇÃO INTEIRA DE ALARGAR.
   *
   * Item de grade com margem inline `auto` NÃO estica: a margem automática o faz
   * ser dimensionado por fit-content e depois o centraliza. E fit-content nunca
   * é menor que o MIN-CONTENT do conteúdo — então o min-content do trilho
   * horizontal dos pilares (580px, medido) virava a largura do miolo, e o
   * documento cresceu com ele.
   *
   * MEDIDO em 390x844: `.diferenciais` continuava com 390px enquanto o
   * `.claro__wrap` dentro dela tinha 628, e o `documentElement.scrollWidth` ia
   * junto — 238px de vazamento horizontal. Só o par (esta linha + o
   * `minmax(0, 1fr)` do celular) fecha: a margem faz o item esticar, o minmax
   * impede a faixa de crescer atrás dele.
   *
   * O `auto` era inofensivo e também inútil aqui: quem centraliza este miolo são
   * as duas colunas `1fr` das pontas, não a margem. Nas outras seções, onde o
   * wrap é filho direto de uma `<section>` em fluxo normal, o `auto` continua
   * valendo e não foi tocado.
   *
   * Detalhe que quase escondeu tudo: `overflow: hidden` nos dois eixos do
   * trilho NÃO zera a contribuição intrínseca dele no Chrome (medido: o miolo
   * seguiu com 628). Contêiner de rolagem não é blindagem de largura.
   */
  .diferenciais > .claro__wrap {
    grid-area: miolo;
    margin-inline: 0;
  }

  /**
   * O BLOCO SANGRA ATÉ A BORDA, O CONTEÚDO DA FOTO NÃO.
   *
   * `env(safe-area-inset)` como padding e não como margem: o carvão continua
   * encostando na borda física da tela (é ele que faz o cartaz), mas a imagem
   * recua da faixa do notch.
   *
   * MEDIDO na auditoria mobile: em paisagem com notch o inset esquerdo é 47px
   * contra 422px de coluna — 11,1% da figura, e não sobra de fundo preto: é
   * exatamente onde estão a mão e a lata de Coca-Cola. Sem isto, o aparelho come
   * o produto.
   *
   * Só nas bordas externas de cada figura. A borda interna encosta no areia e
   * ali não existe notch.
   */
  .dif__gente {
    margin: 0;
    overflow: hidden;
    /* Âncora do véu de revelação (::after). Sem isto ele se posicionaria pela
       seção inteira e cobriria os cartões. */
    position: relative;
    background-color: var(--color-carvao);
    /* O fundo da foto é o mesmo carvão, então onde a imagem não alcança a
       emenda não aparece — a coluna continua sendo um bloco só. */

    /* Declarado AQUI e não herdado: este projeto não tem reset global de
       box-sizing (conferido — `box-sizing` não aparece em nenhum lugar de
       src/). Sem isto o padding de safe-area abaixo SOMA à largura da coluna e
       vira overflow horizontal na paisagem com notch, que é exatamente o
       defeito que o padding existe para não causar. */
    box-sizing: border-box;
  }
  .dif__gente--esq { padding-left: env(safe-area-inset-left); }
  .dif__gente--dir { padding-right: env(safe-area-inset-right); }
  .dif__gente--esq { grid-area: esq; }
  .dif__gente--dir { grid-area: dir; }

  .dif__gente img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* 22% na vertical e não `center`: a coluna do desktop é estreita e alta, e
       centrar cortaria a cabeça. Ancorando perto do topo, rosto e produto ficam
       no quadro e o corte cai na barra do traje, que não carrega informação. */
    object-position: 50% 22%;
  }
  /**
   * A HORIZONTAL É DIFERENTE EM CADA FOTO, porque o que importa está em lugares
   * diferentes do quadro. Centrar as duas é o que estava comendo a lata de um
   * lado e a placa do outro.
   *
   *   esquerda  a lata de Coca-Cola está na borda esquerda do quadro -> 38%
   *   direita   a placa "VEM PARA A YARD" ocupa a metade direita     -> 60%
   *
   * Só no desktop. No celular a figura é quase tão larga quanto a foto e não há
   * o que escolher — as duas aparecem praticamente inteiras.
   */
  .dif__gente--esq img { object-position: 38% 22%; }
  .dif__gente--dir img { object-position: 60% 22%; }

  /**
   * O PRETO DA FOTO NÃO É O PRETO DA MARCA — medido, e a diferença aparece.
   *
   * O fundo de estúdio destas fotos é `#020202`: preto neutro, sem temperatura.
   * O carvão da casa é `#140c06`, marrom quente. Quando os dois se encostam na
   * página — e eles se encostam, porque a Cena 2 termina em carvão logo acima
   * destas colunas — o olho lê dois pretos diferentes, e a seção parece montada
   * com peças de origens distintas.
   *
   * O aquecimento é mínimo de propósito: o suficiente para o preto pertencer à
   * paleta, sem tocar no thobe branco nem no vermelho do keffiyeh, que são o
   * assunto da foto. Um `sepia` mais alto amarelaria a roupa branca, que é
   * exatamente o tipo de correção que se nota.
   */
  .dif__gente img {
    filter: sepia(0.12) saturate(1.05) hue-rotate(-4deg);
  }

  /**
   * AS DUAS PESSOAS GANHARAM PARALLAX E REVELAÇÃO — sem uma linha de JS.
   *
   * `animation-timeline: view()` roda no compositor e já é o instrumento que
   * esta página usa para parallax fora da Cena 2 (ver tokens.css). GSAP aqui
   * não se justifica: ele existe no projeto para pin + scrub de sete camadas, e
   * um elemento que anda mais devagar que a rolagem é exatamente o que a
   * primitiva nativa faz. Onde ela não existe, o @supports não aplica nada e as
   * fotos ficam paradas — nunca quebradas.
   *
   * O PEDIDO ERA yPercent -12 COM scale 1.15 -> 1, E ISSO DESCOBRE A MOLDURA.
   * A imagem é `object-fit: cover` numa figura com `overflow: hidden`: em
   * scale 1.0 ela cobre exatamente a caixa e QUALQUER deslocamento vertical
   * abre uma faixa de carvão numa das pontas. A sobra de cobertura é (escala-1)
   * dividida por 2 — em 1,08 são 4% por ponta, então ±3% de deslocamento passa
   * com 1% de folga. Medido em `.tmp-medir-dif.mjs` nas cinco viewports: zero
   * pixel de moldura aparecendo em qualquer ponto do trilho.
   */
  .dif__gente::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-carvao);
    pointer-events: none;
    /**
     * ESTADO DE REPOUSO É REVELADO, e é isso que faz reduced-motion funcionar.
     *
     * O véu nasce FORA do caminho. Quem recusa movimento, quem está num browser
     * sem scroll-driven animation e quem tem JS desligado veem a foto inteira,
     * porque nada precisa rodar para tirar o véu — ele já saiu. O inverso
     * (nascer cobrindo e depender da animação) deixaria a foto preta nesses
     * três casos, que é o defeito clássico de revelação por scroll.
     */
    transform: translateY(101%);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .dif__gente img {
        animation: dif-gente-parallax linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      .dif__gente::after {
        animation: dif-gente-veu linear both;
        animation-timeline: view();
        /**
         * `cover` e não `entry`, e o motivo é aritmético: no desktop a figura
         * tem a altura da seção (876px medidos em 1440x900) e `entry 100%` só
         * existe quando o elemento CABE inteiro na viewport. Numa janela mais
         * baixa que a figura esse ponto nunca chega, a animação nunca completa
         * e o véu ficaria parado no meio da foto — preto sobre metade da
         * pessoa. `cover` mede a travessia inteira e 18% dela sempre acontece.
         */
        animation-range: cover 0% cover 18%;
      }
    }
  }

  @keyframes dif-gente-parallax {
    from {
      transform: translate3d(0, -3%, 0) scale(1.16);
    }
    to {
      transform: translate3d(0, 3%, 0) scale(1.08);
    }
  }

  /* O véu desce e descobre a foto de cima para baixo — a mesma direção em que
     a figura entra na tela quando a pessoa rola. Subir revelaria pelo pé, que
     é contra o movimento e lê como falha de carregamento. */
  @keyframes dif-gente-veu {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(101%);
    }
  }

  /**
   * CELULAR — as duas descem, e continuam sendo duas.
   *
   * Nada de `display: none`: o público desta landing é celular, e esconder no
   * celular o que existe no desktop é esconder da maioria. O que muda é o papel
   * — de moldura lateral para um par que fecha a seção.
   *
   * A ordem esquerda/direita se mantém porque as áreas nomeadas respeitam o DOM.
   * `aspect-ratio` em vez de altura fixa: cada figura ocupa metade da largura e
   * a altura sai da proporção, então não há número para envelhecer.
   */
  @media (max-width: 900px) {
    /**
     * `minmax(0, 1fr)` E NÃO `1fr` — a mesma precaução que a regra de desktop já
     * tomava, e que aqui ninguém tinha tomado porque nada exigia.
     *
     * `1fr` é `minmax(auto, 1fr)`, ou seja, o mínimo da faixa é o min-content do
     * que está dentro. Com o trilho horizontal no miolo esse min-content passou
     * a ser 580px, e a faixa cresceria atrás do item. Anda em par com o
     * `margin-inline: 0` do wrap: sem os dois, o vazamento volta.
     *
     * ARMADILHA DE MEDIÇÃO que quase deixou isto passar: quando o documento
     * transborda, o Chrome em emulação móvel alarga o bloco contenedor inicial,
     * e `window.innerWidth` cresce junto — 628 contra 628. Quem compara
     * `scrollWidth` com `innerWidth` lê ZERO de vazamento com 238px vazando. A
     * comparação honesta é `scrollWidth` contra `clientWidth`.
     */
    .diferenciais {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        'miolo miolo'
        'esq   dir';
    }
    .diferenciais > .claro__wrap { padding-bottom: 2.5rem; }
    .dif__gente { aspect-ratio: 3 / 4; }
    .dif__gente img { object-position: 50% 18%; }
  }
  /* O wrap so encosta na borda em tela estreita (abaixo dos 68rem de max-width),
     que e justamente onde ha notch. Os env() valem 0 no resto. */
  .claro__wrap {
    max-width: 68rem;
    margin-inline: auto;
    padding-block: 5rem;
    padding-left: calc(1.5rem + env(safe-area-inset-left));
    padding-right: calc(1.5rem + env(safe-area-inset-right));
  }
  .secao__titulo {
    font-family: var(--font-display);
    font-size: var(--text-titulo);
    text-transform: uppercase;
  }
  .secao__texto { margin-top: 0.75rem; max-width: 38rem; line-height: 1.6; }

  /**
   * OS QUATRO PILARES: QUATRO COLUNAS NO DESKTOP, TRILHO HORIZONTAL NO CELULAR.
   *
   * Era `repeat(auto-fit, minmax(15rem, 1fr))`, e com quatro cartões isso nunca
   * fechava uma linha: medido em 1440x900 dava 3 + 1 órfão, e em celular
   * deitado (844x390) o mesmo 3 + 1. O quarto argumento da casa aparecia
   * sozinho embaixo, parecendo sobra. Com quatro colunas iguais o miolo de
   * 944px dá 218px por cartão — cabe, e a linha fecha.
   *
   * Flex e não grid porque é a MESMA declaração que vira trilho no celular
   * trocando a base do item: nenhum cartão é escondido por breakpoint, todos os
   * quatro continuam no DOM e alcançáveis nas duas larguras. O que muda é se a
   * pessoa lê os quatro de uma vez ou deslizando.
   */
  .pilares {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;

    /* A cascata desta seção: 50px de subida em 400ms, o que o cliente pediu.
       O passo entre cartões vem do `data-reveal="80"` no HTML. */
    --reveal-dist: 50px;
    --reveal-dur: 0.4s;
  }
  .pilares > .pilar {
    flex: 1 1 0;
    /* Item flex tem `min-width: auto`: sem zerar, uma palavra longa do título
       empurra a coluna e desiguala as quatro. */
    min-width: 0;
  }

  /**
   * CELULAR — O PIN HORIZONTAL QUE NÃO É UM PIN.
   *
   * O pedido era travar a seção e passar os cartões na horizontal. A página já
   * gasta seu único pin na Cena 2, e um segundo trilho disputando a rolagem com
   * o primeiro é exatamente o que trava no celular. `scroll-snap` nativo entrega
   * o movimento horizontal com ZERO javascript, sem sequestrar a rolagem
   * vertical e sem competir com nada: quem quiser continuar descendo, desce.
   *
   * A mesma consulta do motion.js e do VideoScene: "é aparelho pequeno?" se
   * pergunta pelo LADO CURTO. Um iPhone deitado tem 844px de largura e passaria
   * por desktop — e é justamente deitado que o 3 + 1 órfão aparecia.
   *
   * `min(78%, 20rem)`: a porcentagem sozinha dava cartão de 620px no celular
   * deitado, largo demais para ser cartão. O teto em rem trava isso e mantém a
   * espiada do próximo, que é a única pista de que existe mais coisa à direita.
   */
  @media (max-width: 900px), (max-height: 500px) {
    .pilares {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      /* A barra nativa é overlay no celular e não aparece; escondê-la evita a
         faixa cinza fixa que os browsers de desktop desenham quando alguém
         estreita a janela. A espiada do cartão seguinte é a pista. */
      scrollbar-width: none;
      /* Sobra para a sombra do foco não ser recortada pelo próprio scroller. */
      padding-block-end: 0.5rem;
    }
    .pilares::-webkit-scrollbar {
      display: none;
    }
    .pilares > .pilar {
      flex: 0 0 min(78%, 20rem);
      scroll-snap-align: start;
    }
  }

  /* Cartao com regua: o icone ganha area propria e a linha de brasa separa
     simbolo de texto. Sem isso o bloco lia como documento, nao como pagina. */
  .pilar {
    position: relative;
    /* Recorta o número fantasma na borda do cartão. Sem isto ele vaza para o
       areia da seção e, no celular, vira rolagem horizontal do documento. */
    overflow: hidden;
    /* Cria o contexto de empilhamento do cartão: sem isto o `z-index: -1` do
       número o joga para trás do FUNDO do cartão e ele desaparece. */
    isolation: isolate;
    padding: 1.6rem 1.4rem;
    border-radius: 1rem;
    background-color: var(--color-creme);
    border: 1px solid rgb(139 74 43 / 0.14);
  }

  /**
   * O NÚMERO FANTASMA — 01 a 04 em contorno, atrás do conteúdo.
   *
   * Contorno e não preenchimento: preenchido, mesmo a 14%, ele vira um bloco de
   * cor atrás do parágrafo e disputa a leitura. O contorno de 1,5px deixa
   * passar o creme do cartão entre as linhas do texto.
   *
   * Fica no canto inferior direito porque é onde as linhas do parágrafo
   * terminam mais curtas — o corpo do texto passa por cima do vazio do número,
   * não por cima do traço.
   */
  .pilar__numero {
    position: absolute;
    right: 0.75rem;
    bottom: 0.6rem;
    z-index: -1;
    font-family: var(--font-display);
    font-size: 7rem;
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(139 74 43 / 0.16);
    pointer-events: none;
    user-select: none;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pilar__numero {
        animation: dif-numero linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }

  /**
   * "Mais lento que o cartão" tem um sinal, e ele é fácil de inverter.
   *
   * O cartão sobe junto com a rolagem. Para o número parecer mais LENTO ele
   * precisa ficar para trás, ou seja, descer em relação ao cartão enquanto a
   * seção atravessa a tela: de -10% para +10%. O contrário (de +10% para -10%)
   * o faz correr na frente do cartão, que é a leitura oposta.
   *
   * 10% de uma linha de 7rem são ~9,5px, e o número está a 0,6rem da borda —
   * então ele nunca encosta no recorte do cartão. Se ele saísse e voltasse, o
   * pedaço cortado mudaria de tamanho durante a rolagem e leria como defeito.
   */
  @keyframes dif-numero {
    from {
      transform: translate3d(0, -10%, 0);
    }
    to {
      transform: translate3d(0, 10%, 0);
    }
  }
  .pilar__icone {
    display: inline-flex;
    padding-bottom: 0.9rem;
    margin-bottom: 0.9rem;
    color: var(--color-terracota);
    border-bottom: 2px solid var(--color-brasa);
  }
  .pilar__titulo {
    font-family: var(--font-display);
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .pilar__texto { margin-top: 0.5rem; line-height: 1.6; font-size: 0.95rem; opacity: 0.85; }

  /* Foto ocupa a largura do cartao. Antes era miniatura de 8rem num canto e a
     secao lia como lista de delivery — o feedback foi exatamente esse. Com a
     reamostragem para 480px a foto aguenta ser exibida grande. */
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 1rem;
    overflow: hidden;
    background-color: var(--color-carvao);
    color: var(--color-creme);
  }
  .card > :not(.card__foto) { padding-inline: 1.6rem; }
  .card > :last-child { padding-bottom: 1.75rem; }
  .card--destaque { background-color: var(--color-terracota); }
  /* O carro-chefe merece largura dobrada onde houver espaco. */
  @media (min-width: 60rem) {
    .cards { grid-template-columns: repeat(2, 1fr); }
    .card--destaque { grid-column: 1 / -1; flex-direction: row; }
    /* 1/1 e nao `auto`: as fotos do Brendi sao quadradas, e `auto` faz o
       navegador esperar a imagem chegar para saber a altura. Como ela e lazy,
       a reserva so aparecia no load e a secao crescia 320px com a pessoa
       olhando — medido em 26/08, no desktop. Com a razao declarada, o espaco
       existe desde o primeiro paint. `object-fit: cover` continua garantindo
       que foto fora do quadrado nao distorca. */
    /* `flex: 0 0 45%` e nao `width: 45%`.
       Num flex row, largura em porcentagem ainda passa pelo encolhimento, e o
       tamanho base vem do conteudo — que, numa <img> lazy, so existe depois do
       download. Medido em 26/08 no desktop: a foto do carro-chefe nascia com
       171px e virava 468px ao chegar, empurrando ~300px da pagina para baixo
       com a pessoa olhando. Com a base travada, os 45% valem desde o primeiro
       paint.

       aspect-ratio 1/1 (e nao `auto`) pelo mesmo motivo: `auto` manda o
       navegador esperar a imagem para saber a altura. As fotos do Brendi sao
       quadradas e `object-fit: cover` cobre quem nao for. */
    .card--destaque .card__foto {
      flex: 0 0 45%;
      /* Item flex tem `min-width: auto` por padrao, e isso deixa o tamanho
         INTRINSECO da imagem (480px) vencer a base de 45% quando ela chega —
         sobravam 12px de crescimento mesmo com a base travada. */
      min-width: 0;
      aspect-ratio: 1 / 1;
      margin-bottom: 0;
    }
    .card--destaque > :not(.card__foto) { padding-top: 1.75rem; }
  }
  .card__selo {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brasa);
  }
  .card--destaque .card__selo { color: var(--color-areia); }

  /* O CDN do Brendi so entrega 240x240. Exibir contido em ~8.5rem mantem
     densidade ~1.8x, ou seja, nitido em retina. Esticar para a largura do card
     entregaria foto borrada — e foto de comida borrada vende menos que
     nenhuma. Quando houver material em alta do dono, isso vira full-bleed. */
  .card__foto {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    margin-bottom: 1.4rem;
  }
  .card__nome {
    font-family: var(--font-display);
    font-size: 1.6rem;
    text-transform: uppercase;
    margin-top: 0.35rem;
  }
  .card__texto { margin-top: 0.6rem; line-height: 1.6; font-size: 0.95rem; color: var(--color-areia); }

  .cardapio { background-color: var(--color-creme); color: var(--color-carvao); }
  .cardapio__cta { margin-top: 2rem; }
  .cardapio__nota {
    margin-top: 1rem;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  /**
   * Cena 6 — combos.
   *
   * Era a unica secao com fundo brasa inteiro e o feedback foi direto: parecia
   * "site de entrada". Laranja chapado em tela cheia achata tudo, e os cartoes
   * a 7% de preto por cima praticamente sumiam.
   *
   * Agora o fundo e carvao e a brasa vira acento — a mesma cor, usada como
   * detalhe em vez de tinta de parede.
   */
  .combos { background-color: var(--color-carvao); color: var(--color-creme); }
  .combos .secao__titulo { color: var(--color-creme); }
  .combos .secao__texto { color: var(--color-areia); }
  .combos__cta { margin-top: 2.5rem; }

  .combos__lista {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin-top: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  /* Combo e leitura rapida: foto a esquerda, o que vem dentro a direita.
     Sem preco por decisao de arquitetura — preco vive no Brendi, onde muda. */
  .combo {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 0.85rem;
    border-radius: 0.9rem;
    background-color: rgb(232 220 200 / 0.06);
    border: 1px solid rgb(232 220 200 / 0.1);
  }
  .combo__foto {
    flex-shrink: 0;
    width: 6.5rem;
    height: 6.5rem;
    object-fit: cover;
    border-radius: 0.65rem;
  }
  .combo__nome {
    font-family: var(--font-display);
    font-size: 1.3rem;
    text-transform: uppercase;
    line-height: 1.05;
    color: var(--color-brasa);
  }
  .combo__composicao {
    margin-top: 0.35rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-areia);
  }

  .onde { background-color: var(--color-creme); color: var(--color-carvao); }
  .onde__endereco { font-style: normal; line-height: 1.6; }
  .onde__dado { border-top: 1px solid rgb(139 74 43 / 0.18); padding-top: 1rem; }

  /**
   * O SELO DE ABERTO/FECHADO — cor semântica, e não só cor.
   *
   * O ponto colorido antes do texto é decoração: quem não distingue verde de
   * vermelho lê "Aberto agora" ou "Fechado agora" escrito, que é a informação
   * inteira. Cor aqui confirma, nunca carrega sozinha.
   *
   * O verde não é o verde de sistema: é puxado para a oliva do cerrado para não
   * brigar com a brasa e o terracota da paleta. O fechado usa o próprio
   * terracota da marca em vez de vermelho de alerta — a casa fechar às 23h20
   * não é erro, é o expediente.
   */
  .onde__estado {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .onde__estado::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: currentColor;
    flex: none;
  }
  .onde__estado[data-aberto='true'] { color: #4A6B24; }
  .onde__estado[data-aberto='false'] { color: var(--color-terracota); }
  /**
   * COPIAR ENDEREÇO — 44px de alvo sem virar um segundo CTA.
   *
   * O padding entrega os 44px auditados sem inchar a tipografia: o rótulo
   * continua em 0,85rem, do tamanho do dado que ele serve. A cor é terracota e
   * não fogo porque `--yard-fogo` é reservado a quem leva ao cardápio — botão
   * utilitário que rouba a cor do CTA enfraquece o CTA.
   *
   * O aviso vive na mesma linha, com margem só quando tem texto: região
   * aria-live precisa estar no DOM desde o começo, e um `display: none`
   * intermitente é exatamente o que faz leitor de tela perder o anúncio.
   */
  .onde__copiar-linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0.75rem 0 0;
  }
  .onde__copiar {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding-inline: 0.9rem;
    border: 1px solid rgb(139 74 43 / 0.4);
    border-radius: 999px;
    background-color: transparent;
    color: var(--color-terracota);
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .onde__copiar:hover {
    background-color: rgb(139 74 43 / 0.08);
    border-color: var(--color-terracota);
  }
  .onde__copiar-icone { flex: none; fill: currentColor; }
  .onde__copiado {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .onde__copiado:not(:empty) { margin-left: 0.75rem; }
  /* Mesma dupla semântica do selo de aberto/fechado: a cor confirma o texto,
     nunca o substitui. */
  .onde__copiado[data-ok='true'] { color: #3f5c1f; }
  .onde__copiado[data-ok='false'] { color: var(--color-terracota); }

  .onde__pgto {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
